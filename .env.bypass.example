# Copy to .env.bypass for a side-by-side Docker deployment.
# These ports avoid the default 80/443/8090/1337 paths so OpenResty can keep
# routing the current production version while the Docker stack is verified.

ADMIN_PORT=18080
HONO_PORT=11337
POCKETBASE_PORT=18090
BIND_ADDR=127.0.0.1

VITE_OPS_API_BASE=/ops
VITE_OPS_API_MOCK=false

PB_EMAIL=admin@example.com
PB_PASSWORD=change-me

PB_PUBLIC_URL=https://data.ikanyue.com
PUBLIC_ASSET_BASE_URL=https://kyoss.abcmem.com
DEFAULT_AVATAR=

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_JSCODE2SESSION=https://api.weixin.qq.com/sns/jscode2session
