## 错误处理模式

### 全局错误处理
```javascript
// 在 app.js 中设置
export default {
  onError(err) {
    console.error('小程序发生错误:', err)
    // 可以在这里上报错误到监控系统
  }
}
```

### 组件级错误处理
```javascript
import { ref } from 'vue'
import Taro from '@tarojs/taro'

const handleError = (error, action = '操作') => {
  console.error(`${action}失败:`, error)
  
  Taro.showToast({
    title: `${action}失败，请重试`,
    icon: 'none'
  })
}
```

