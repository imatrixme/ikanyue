### 表单组件
```vue
<template>
  <nut-form ref="formRef" :model="formData" :rules="rules">
    <nut-form-item label="用户名" prop="username">
      <nut-input
        v-model="formData.username"
        placeholder="请输入用户名"
        clear-icon
      />
    </nut-form-item>
    
    <nut-form-item label="密码" prop="password">
      <nut-input
        v-model="formData.password"
        type="password"
        placeholder="请输入密码"
      />
    </nut-form-item>
    
    <nut-button type="primary" @click="handleSubmit">
      提交
    </nut-button>
  </nut-form>
</template>

<script setup>
import { ref } from 'vue'

const formRef = ref()
const formData = ref({
  username: '',
  password: ''
})

const rules = {
  username: [{ required: true, message: '请输入用户名' }],
  password: [{ required: true, message: '请输入密码' }]
}

const handleSubmit = () => {
  formRef.value.validate().then(() => {
    // 表单验证通过，提交数据
  }).catch(() => {
    // 验证失败
  })
}
</script>
```

## 路由导航模式

### 页面跳转
```javascript
import Taro from '@tarojs/taro'

// 跳转到 tabBar 页面
const navigateToTab = () => {
  Taro.switchTab({
    url: '/pages/activity/index'
  })
}

// 跳转到普通页面
const navigateToPage = (id) => {
  Taro.navigateTo({
    url: `/pages/activityDetail/index?id=${id}`
  })
}

// 返回上一页
const goBack = () => {
  Taro.navigateBack()
}

// 重定向
const redirectTo = () => {
  Taro.redirectTo({
    url: '/pages/login/index'
  })
}
```

### 路由参数获取
```javascript
import { ref, onMounted } from 'vue'
import Taro from '@tarojs/taro'

const routeParams = ref({})

onMounted(() => {
  const instance = Taro.getCurrentInstance()
  routeParams.value = instance.router.params
})
```

## 存储和缓存模式

### 本地存储
```javascript
import Taro from '@tarojs/taro'

// 设置存储
const setStorage = (key, data) => {
  return Taro.setStorage({
    key,
    data
  })
}

// 获取存储
const getStorage = (key) => {
  return Taro.getStorage({
    key
  }).then(res => res.data)
}

// 删除存储
const removeStorage = (key) => {
  return Taro.removeStorage({
    key
  })
}

// 清空存储
const clearStorage = () => {
  return Taro.clearStorage()
}
```

