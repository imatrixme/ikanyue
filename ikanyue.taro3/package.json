{
	"name": "sing.taro3",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@10.19.0",
	"engines": {
		"node": ">=22.15 <23"
	},
	"description": "看乐艺术",
	"templateInfo": {
		"name": "vue3-NutUI",
		"typescript": false,
		"css": "sass"
	},
	"scripts": {
		"icons:generate": "node scripts/generate-icons.mjs",
		"prebuild:weapp": "node scripts/clean-weapp-output.mjs",
		"predev:weapp": "node scripts/clean-weapp-output.mjs",
		"visual:styles": "sass tests/visual/inclusive-design-fixture.scss output/playwright/inclusive-design-fixture.css --style=expanded --no-source-map",
		"lint": "eslint src utils scripts tests --ext .js,.mjs,.vue --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"course-calendar:test:coverage": "vitest run --config vitest.course-calendar.config.mjs --coverage",
		"test:e2e": "node tests/e2e/points-lite-build.test.mjs",
		"verify:student-course-boundary": "node scripts/verify-student-course-boundary.mjs",
		"build:weapp": "node scripts/verify-student-course-boundary.mjs && taro build --type weapp && node scripts/check-weapp-output.mjs",
		"build:swan": "taro build --type swan",
		"build:alipay": "taro build --type alipay",
		"build:tt": "taro build --type tt",
		"build:h5": "taro build --type h5",
		"build:rn": "taro build --type rn",
		"build:qq": "taro build --type qq",
		"build:jd": "taro build --type jd",
		"build:quickapp": "taro build --type quickapp",
		"dev:weapp": "taro build --type weapp --watch --env development",
		"dev:swan": "npm run build:swan -- --watch",
		"dev:alipay": "npm run build:alipay -- --watch",
		"dev:tt": "npm run build:tt -- --watch",
		"dev:h5": "npm run build:h5 -- --watch",
		"dev:rn": "npm run build:rn -- --watch",
		"dev:qq": "npm run build:qq -- --watch",
		"dev:jd": "npm run build:jd -- --watch",
		"dev:quickapp": "npm run build:quickapp -- --watch"
	},
	"browserslist": [
		"last 3 versions",
		"Android >= 4.1",
		"ios >= 8"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@babel/runtime": "^7.29.7",
		"@nutui/nutui-taro": "^3.3.8",
		"@tarojs/components": "4.2.1",
		"@tarojs/helper": "4.2.1",
		"@tarojs/plugin-framework-vue3": "4.2.1",
		"@tarojs/plugin-html": "4.2.1",
		"@tarojs/plugin-platform-alipay": "4.2.1",
		"@tarojs/plugin-platform-jd": "4.2.1",
		"@tarojs/plugin-platform-qq": "4.2.1",
		"@tarojs/plugin-platform-swan": "4.2.1",
		"@tarojs/plugin-platform-tt": "4.2.1",
		"@tarojs/plugin-platform-weapp": "4.2.1",
		"@tarojs/router": "4.2.1",
		"@tarojs/runtime": "4.2.1",
		"@tarojs/shared": "4.2.1",
		"@tarojs/taro": "4.2.1",
		"@tarojs/taro-h5": "4.2.1",
		"vue": "^3.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@tarojs/cli": "4.2.1",
		"@tarojs/plugin-doctor": "0.0.19",
		"@tarojs/plugin-platform-h5": "4.2.1",
		"@tarojs/runner-utils": "4.2.1",
		"@tarojs/service": "4.2.1",
		"@tarojs/webpack5-runner": "4.2.1",
		"@types/webpack-env": "^1.13.6",
		"@vitest/coverage-v8": "^4.1.10",
		"@vue/babel-plugin-jsx": "^1.5.0",
		"@vue/compiler-sfc": "^3.0.0",
		"babel-plugin-import": "^1.13.8",
		"babel-preset-taro": "4.2.1",
		"eslint": "^8.12.0",
		"eslint-config-taro": "4.2.1",
		"eslint-plugin-vue": "^8.0.0",
		"lucide-static": "^1.24.0",
		"postcss": "^8.5.26",
		"stylelint": "9.3.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"vue-loader": "^17.4.2",
		"webpack": "5.109.2"
	}
}
