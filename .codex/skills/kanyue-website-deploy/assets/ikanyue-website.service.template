[Unit]
Description=Kanyue official website (Nuxt)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{APP_ROOT}}/current
Environment=NODE_ENV=production
Environment=NITRO_HOST=127.0.0.1
Environment=NITRO_PORT={{LIVE_PORT}}
Environment=NUXT_PUBLIC_API_BASE={{API_BASE}}
Environment=NUXT_PUBLIC_SITE_URL={{SITE_URL}}
ExecStart={{NODE_BIN}} {{APP_ROOT}}/current/.output/server/index.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
