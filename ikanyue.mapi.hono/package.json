{
  "name": "ikanyue-hono",
  "private": true,
  "version": "0.0.0",
  "description": "backend for ikanyue using hono.js",
  "keywords": [],
  "main": "src/app.js",
  "scripts": {
    "start": "NODE_ENV=production node src/app.js",
    "dev": "node --watch src/app.js",
    "dev:bun": "bun run --watch src/app.js",
    "start:bun": "NODE_ENV=production bun run src/app.js",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/routes/ops/*.js' --test-coverage-include='src/routes/points/*.js' --test-coverage-include='src/services/points/*.js' --test-coverage-include='src/middleware/opsAuth.js' --test-coverage-include='src/middleware/auth.js' --test-coverage-include='src/services/ops/authService.js' --test-coverage-include='src/services/ops/auditService.js' --test-coverage-include='src/services/ops/opsUtils.js' --test-coverage-include='src/services/ops/schema.js' --test-coverage-exclude='src/services/ops/pocketbaseTeacherAuth.js' --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95",
    "ops:schema:check": "node scripts/check-ops-schema.js",
    "ops:schema:apply": "node scripts/pb-ensure-ops-schema.js",
    "ops:seed:local": "node scripts/pb-seed-points-lite-local.js",
    "ops:smoke:local": "node scripts/smoke-points-lite-local.js",
    "check-docs": "./scripts/check-docs.sh",
    "swagger:collect": "node scripts/collect-swagger.js",
    "swagger:serve": "node scripts/serve-swagger.js",
    "swagger:dev": "npm run swagger:collect && npm run swagger:serve",
    "swagger:build": "npm run swagger:collect && echo '✅ Swagger 文档已生成到 docs/swagger.json'"
  },
  "dependencies": {
    "@hono/node-server": "^1.4.1",
    "hono": "^3.11.7",
    "pocketbase": "^0.25.2",
    "await-to-js": "^2.1.1",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^8.5.1",
    "licia": "^1.27.0",
    "dayjs": "^1.9.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "bun-types": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:imatrixme/ikanyue.mapi.hono.git"
  },
  "author": "matrixme",
  "license": "",
  "engines": {
    "bun": "^1.0.0"
  }
}
