{
  "name": "ikanyue-hono",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "version": "0.0.0",
  "description": "backend for ikanyue using hono.js",
  "keywords": [],
  "main": "src/app.js",
  "scripts": {
    "start": "NODE_ENV=production node src/app.js",
    "dev": "node --watch src/app.js",
    "dev:bun": "bun run --watch src/app.js",
    "start:bun": "NODE_ENV=production bun run src/app.js",
    "lint": "node scripts/verify-no-pocketbase-hooks.js && eslint src --max-warnings=0",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/routes/ops/*.js' --test-coverage-include='src/routes/points/*.js' --test-coverage-include='src/services/points/*.js' --test-coverage-include='src/middleware/opsAuth.js' --test-coverage-include='src/middleware/auth.js' --test-coverage-include='src/services/ops/authService.js' --test-coverage-include='src/services/ops/auditService.js' --test-coverage-include='src/services/ops/opsUtils.js' --test-coverage-include='src/services/ops/schema.js' --test-coverage-include='src/services/ops/studentAdminService.js' --test-coverage-exclude='src/services/ops/pocketbaseTeacherAuth.js' --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95",
    "course-credits:test:coverage": "c8 --all --include='src/routes/courseCredits/**/*.js' --include='src/routes/user/wechatLogin.js' --include='src/routes/user/wechatRole.js' --include='src/services/courseCredits/**/*.js' --include='scripts/course-booking-worker.js' --include='scripts/course-credit-pocketbase-backup.js' --include='scripts/generate-course-credit-migrations.js' --include='scripts/verify-course-credit-pocketbase.js' --include='scripts/verify-no-pocketbase-hooks.js' --reporter=text --reporter=json-summary --check-coverage --lines=95 --branches=95 --functions=95 --statements=95 node --test 'test/courseCredit*.test.js' 'test/courseBooking*.test.js' 'test/wechatLogin*.test.js'",
    "course-calendar:test:coverage": "c8 --all --include='src/services/courseCredits/schedule/*.js' --include='src/routes/courseCredits/scheduleHandlers.js' --include='src/services/courseCredits/studentLearningService.js' --reporter=text --reporter=json-summary --check-coverage --lines=95 --branches=95 --functions=95 --statements=95 node --test 'test/courseCalendar*.test.js' 'test/courseCreditStudentLearningService.test.js'",
    "verify:no-pocketbase-hooks": "node scripts/verify-no-pocketbase-hooks.js",
    "ops:schema:check": "node scripts/check-ops-schema.js",
    "ops:schema:apply": "node scripts/pb-ensure-ops-schema.js",
    "course-credits:migrations:generate": "node scripts/generate-course-credit-migrations.js",
    "course-credits:schema:apply": "node scripts/pb-ensure-course-credit-schema.js",
    "course-credits:verify:pocketbase": "node scripts/verify-course-credit-pocketbase.js",
    "course-credits:test:pocketbase-business": "PB_COURSE_CREDIT_INTEGRATION=1 node --test 'test/courseCredit*Integration.test.js'",
    "course-credits:backup": "node scripts/course-credit-pocketbase-backup.js backup",
    "course-credits:restore": "node scripts/course-credit-pocketbase-backup.js restore",
    "course-credits:restore:finalize": "node scripts/course-credit-pocketbase-backup.js restore-finalize",
    "course-bookings:workers": "node scripts/course-booking-worker.js",
    "course-bookings:seed:local": "node scripts/pb-seed-course-booking-local.js",
    "ops:seed:local": "node scripts/pb-seed-points-lite-local.js",
    "ops:smoke:local": "node scripts/smoke-points-lite-local.js",
    "check-docs": "./scripts/check-docs.sh",
    "swagger:collect": "node scripts/collect-swagger.js",
    "swagger:serve": "node scripts/serve-swagger.js",
    "swagger:dev": "npm run swagger:collect && npm run swagger:serve",
    "swagger:build": "npm run swagger:collect && echo '✅ Swagger 文档已生成到 docs/swagger.json'"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "await-to-js": "^2.1.1",
    "dayjs": "^1.9.4",
    "dotenv": "^16.4.7",
    "hono": "^4.13.2",
    "jsonwebtoken": "^9.0.3",
    "licia": "^1.27.0",
    "pocketbase": "^0.25.2"
  },
  "devDependencies": {
    "bun-types": "latest",
    "c8": "^12.0.0",
    "eslint": "^8.57.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:imatrixme/ikanyue.mapi.hono.git"
  },
  "author": "matrixme",
  "license": "",
  "engines": {
    "bun": "^1.0.0",
    "node": ">=22.15 <23",
    "npm": ">=10"
  }
}
