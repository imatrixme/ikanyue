# PocketBase 配置
PB_URL=http://127.0.0.1:8090
PB_EMAIL=admin@example.com
PB_PASSWORD=your_password

# JWT 签名密钥（生产必填，至少 32 位；生成：openssl rand -hex 32）
JWT_SECRET=

# S3 配置
S3_URL=https://kyoss.abcmem.com
S3_BUCKET=ikanyue-mp

# 应用配置
PORT=1337
NODE_ENV=development
OPS_REGISTRATION_ENABLED=false

# 默认头像
DEFAULT_AVATAR=https://example.com/default-avatar.png 

# 微信小程序配置
WECHAT_APPID=your_mini_program_appid
WECHAT_SECRET=your_mini_program_secret
WECHAT_JSCODE2SESSION=https://api.weixin.qq.com/sns/jscode2session

# 课程预约外部 worker（由 1Panel 等调度器定时执行）
COURSE_BOOKING_WORKER_BASE_URL=http://127.0.0.1:1337
COURSE_BOOKING_WORKER_ACCOUNT=dedicated_booking_worker
COURSE_BOOKING_WORKER_PASSWORD=replace_with_a_strong_password
COURSE_BOOKING_WORKER_INTERVAL_MINUTES=5
COURSE_BOOKING_WORKER_DELIVER_OUTBOX=false
COURSE_BOOKING_WORKER_OUTBOX_LIMIT=50
