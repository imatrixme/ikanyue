{
    "openapi": "3.0.0",
    "info": {
      "title": "活动更新接口",
      "version": "1.0.0",
      "description": "更新现有活动信息，需要管理员权限。支持部分字段更新，自动进行数据验证和格式转换"
    },
    "paths": {
      "/v1/activity/update": {
        "post": {
          "summary": "更新活动信息",
          "description": "更新现有活动的信息，支持部分字段更新，需要管理员权限",
          "tags": ["Activity"],
          "security": [
            {
              "BearerAuth": []
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "活动ID，必填",
                      "example": "activity_123"
                    },
                    "title": {
                      "type": "string",
                      "description": "活动标题，不能为空",
                      "example": "高级编程工作坊"
                    },
                    "description": {
                      "type": "string",
                      "description": "活动描述，不能为空",
                      "example": "深入学习 JavaScript 高级特性"
                    },
                    "startTime": {
                      "type": "string",
                      "format": "date-time",
                      "description": "活动开始时间 (ISO 8601格式)",
                      "example": "2024-03-01T09:00:00Z"
                    },
                    "endTime": {
                      "type": "string",
                      "format": "date-time",
                      "description": "活动结束时间 (ISO 8601格式)",
                      "example": "2024-03-01T17:00:00Z"
                    },
                    "location": {
                      "type": "string",
                      "description": "活动地点，不能为空",
                      "example": "上海市浦东新区"
                    },
                    "price": {
                      "type": "number",
                      "minimum": 0,
                      "description": "活动价格，必须为非负数",
                      "example": 399
                    },
                    "coverImage": {
                      "type": "string",
                      "description": "封面图片文件名",
                      "example": "new_cover.jpg"
                    },
                    "images": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "图片文件名数组",
                      "example": ["img1.jpg", "img2.jpg", "img3.jpg"]
                    },
                    "externalLink": {
                      "type": "string",
                      "format": "uri",
                      "description": "外部链接",
                      "example": "https://updated.example.com"
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "标签数组",
                      "example": ["高级编程", "JavaScript", "培训"]
                    },
                    "sequence": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "排序序号，必须为非负整数",
                      "example": 200
                    },
                    "maxParticipants": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "最大参与人数，必须为非负整数",
                      "example": 50
                    },
                    "status": {
                      "type": "string",
                      "enum": ["inactive", "active", "cancelled", "completed"],
                      "description": "活动状态",
                      "example": "active"
                    },
                    "type": {
                      "type": "string",
                      "description": "活动类型",
                      "example": "advanced_workshop"
                    }
                  }
                },
                "example": {
                  "id": "activity_123",
                  "title": "高级编程工作坊",
                  "description": "深入学习 JavaScript 高级特性和最佳实践",
                  "price": 399,
                  "maxParticipants": 50,
                  "status": "active",
                  "tags": ["高级编程", "JavaScript", "培训"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "活动更新成功",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer",
                        "example": 10000
                      },
                      "message": {
                        "type": "string",
                        "example": "活动更新成功"
                      },
                      "data": {
                        "$ref": "#/components/schemas/ActivityDetail"
                      }
                    }
                  },
                  "example": {
                    "code": 10000,
                    "message": "活动更新成功",
                    "data": {
                      "id": "activity_123",
                      "title": "高级编程工作坊",
                      "description": "深入学习 JavaScript 高级特性和最佳实践",
                      "startTime": "2024-03-01T09:00:00Z",
                      "endTime": "2024-03-01T17:00:00Z",
                      "location": "上海市浦东新区",
                      "price": 399,
                      "coverImage": "new_cover.jpg",
                      "images": ["img1.jpg", "img2.jpg"],
                      "externalLink": "https://updated.example.com",
                      "tags": ["高级编程", "JavaScript", "培训"],
                      "sequence": 200,
                      "maxParticipants": 50,
                      "currentParticipants": 15,
                      "status": "active",
                      "type": "advanced_workshop",
                      "creator": "admin_id",
                      "created": "2024-01-01 10:00:00",
                      "updated": "2024-01-02 15:30:00"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "请求参数错误",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer",
                        "example": 400
                      },
                      "message": {
                        "type": "string"
                      },
                      "data": {
                        "type": "null",
                        "example": null
                      }
                    }
                  },
                  "examples": {
                    "empty_id": {
                      "summary": "活动ID为空",
                      "value": {
                        "code": 400,
                        "message": "活动ID不能为空",
                        "data": null
                      }
                    },
                    "no_fields": {
                      "summary": "没有更新字段",
                      "value": {
                        "code": 400,
                        "message": "没有提供要更新的字段",
                        "data": null
                      }
                    },
                    "empty_title": {
                      "summary": "标题为空",
                      "value": {
                        "code": 400,
                        "message": "活动标题不能为空",
                        "data": null
                      }
                    },
                    "invalid_price": {
                      "summary": "价格格式错误",
                      "value": {
                        "code": 400,
                        "message": "活动价格必须为非负数",
                        "data": null
                      }
                    },
                    "invalid_time": {
                      "summary": "时间逻辑错误",
                      "value": {
                        "code": 400,
                        "message": "开始时间必须早于结束时间",
                        "data": null
                      }
                    },
                    "data_format_error": {
                      "summary": "数据格式错误",
                      "value": {
                        "code": 400,
                        "message": "数据格式错误，请检查输入",
                        "data": null
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "description": "未授权访问",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer",
                        "example": 401
                      },
                      "message": {
                        "type": "string",
                        "example": "未授权访问"
                      },
                      "data": {
                        "type": "null",
                        "example": null
                      }
                    }
                  }
                }
              }
            },
            "403": {
              "description": "权限不足（非管理员）",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer",
                        "example": 403
                      },
                      "message": {
                        "type": "string",
                        "example": "权限不足"
                      },
                      "data": {
                        "type": "null",
                        "example": null
                      }
                    }
                  }
                }
              }
            },
            "404": {
              "description": "活动不存在",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer",
                        "example": 404
                      },
                      "message": {
                        "type": "string",
                        "example": "活动不存在"
                      },
                      "data": {
                        "type": "null",
                        "example": null
                      }
                    }
                  }
                }
              }
            },
            "500": {
              "description": "服务器内部错误",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer",
                        "example": 500
                      },
                      "message": {
                        "type": "string"
                      },
                      "data": {
                        "type": "null",
                        "example": null
                      }
                    }
                  },
                  "examples": {
                    "query_failed": {
                      "summary": "查询失败",
                      "value": {
                        "code": 500,
                        "message": "查询失败，请稍后重试",
                        "data": null
                      }
                    },
                    "update_failed": {
                      "summary": "更新失败",
                      "value": {
                        "code": 500,
                        "message": "更新失败，请稍后重试",
                        "data": null
                      }
                    },
                    "server_error": {
                      "summary": "服务器异常",
                      "value": {
                        "code": 500,
                        "message": "服务器内部错误",
                        "data": null
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT",
          "description": "管理员 JWT 令牌"
        }
      },
      "schemas": {
        "ActivityDetail": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "example": "activity_123"
            },
            "title": {
              "type": "string",
              "example": "高级编程工作坊"
            },
            "description": {
              "type": "string",
              "example": "深入学习 JavaScript 高级特性和最佳实践"
            },
            "startTime": {
              "type": "string",
              "example": "2024-03-01T09:00:00Z"
            },
            "endTime": {
              "type": "string",
              "example": "2024-03-01T17:00:00Z"
            },
            "location": {
              "type": "string",
              "example": "上海市浦东新区"
            },
            "price": {
              "type": "number",
              "example": 399
            },
            "type": {
              "type": "string",
              "example": "advanced_workshop"
            },
            "status": {
              "type": "string",
              "enum": ["active", "inactive", "cancelled", "completed"],
              "example": "active"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": ["高级编程", "JavaScript", "培训"]
            },
            "coverImage": {
              "type": "string",
              "example": "new_cover.jpg"
            },
            "images": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": ["img1.jpg", "img2.jpg"]
            },
            "maxParticipants": {
              "type": "integer",
              "example": 50
            },
            "currentParticipants": {
              "type": "integer",
              "example": 15
            },
            "externalLink": {
              "type": "string",
              "format": "uri",
              "example": "https://updated.example.com"
            },
            "sequence": {
              "type": "integer",
              "example": 200
            },
            "creator": {
              "type": "string",
              "example": "admin_id"
            },
            "created": {
              "type": "string",
              "example": "2024-01-01 10:00:00"
            },
            "updated": {
              "type": "string",
              "example": "2024-01-02 15:30:00"
            }
          }
        }
      }
    }
  }