{
  "openapi": "3.0.0",
  "info": {
    "title": "活动创建接口",
    "version": "1.0.0",
    "description": "创建新的教学活动，支持设置活动标题、描述、时间、地点、价格等详细信息，需要管理员权限"
  },
  "paths": {
    "/v1/activity/create": {
      "post": {
        "summary": "创建新活动",
        "description": "创建新的教学活动，需要管理员权限。活动默认状态为 inactive，需要手动激活",
        "tags": ["Activity"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "description", "startTime", "endTime", "location", "price"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "活动标题，不能为空",
                    "example": "编程工作坊"
                  },
                  "description": {
                    "type": "string",
                    "description": "活动描述，不能为空",
                    "example": "学习 JavaScript 基础知识"
                  },
                  "startTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "活动开始时间 (ISO 8601格式)",
                    "example": "2024-02-01T09:00:00Z"
                  },
                  "endTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "活动结束时间 (ISO 8601格式)",
                    "example": "2024-02-01T17:00:00Z"
                  },
                  "location": {
                    "type": "string",
                    "description": "活动地点，不能为空",
                    "example": "北京市朝阳区"
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0,
                    "description": "活动价格，必须为非负数",
                    "example": 299
                  },
                  "coverImage": {
                    "type": "string",
                    "description": "封面图片文件名",
                    "example": "cover.jpg",
                    "default": ""
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "图片文件名数组",
                    "example": ["img1.jpg", "img2.jpg"],
                    "default": []
                  },
                  "externalLink": {
                    "type": "string",
                    "format": "uri",
                    "description": "外部链接",
                    "example": "https://example.com",
                    "default": ""
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "标签数组",
                    "example": ["编程", "教育"],
                    "default": []
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "排序序号，必须为非负整数",
                    "example": 100,
                    "default": 0
                  },
                  "maxParticipants": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "最大参与人数，必须为非负整数",
                    "example": 30,
                    "default": 0
                  },
                  "status": {
                    "type": "string",
                    "enum": ["inactive", "active", "cancelled", "completed"],
                    "description": "活动状态",
                    "example": "inactive",
                    "default": "inactive"
                  },
                  "type": {
                    "type": "string",
                    "description": "活动类型",
                    "example": "workshop",
                    "default": ""
                  }
                }
              },
              "example": {
                "title": "编程工作坊",
                "description": "学习 JavaScript 基础知识，适合初学者",
                "startTime": "2024-02-01T09:00:00Z",
                "endTime": "2024-02-01T17:00:00Z",
                "location": "北京市朝阳区科技园",
                "price": 299,
                "type": "workshop",
                "tags": ["编程", "教育", "JavaScript"],
                "maxParticipants": 30,
                "sequence": 100,
                "externalLink": "https://example.com/register",
                "status": "active"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "活动创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 10000
                    },
                    "message": {
                      "type": "string",
                      "example": "活动创建成功"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "new_activity_id"
                        },
                        "title": {
                          "type": "string",
                          "example": "编程工作坊"
                        },
                        "description": {
                          "type": "string",
                          "example": "学习 JavaScript 基础知识"
                        },
                        "startTime": {
                          "type": "string",
                          "example": "2024-02-01T09:00:00Z"
                        },
                        "endTime": {
                          "type": "string",
                          "example": "2024-02-01T17:00:00Z"
                        },
                        "location": {
                          "type": "string",
                          "example": "北京市朝阳区"
                        },
                        "price": {
                          "type": "number",
                          "example": 299
                        },
                        "coverImage": {
                          "type": "string",
                          "example": ""
                        },
                        "images": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "example": []
                        },
                        "externalLink": {
                          "type": "string",
                          "example": ""
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "example": ["编程", "教育"]
                        },
                        "sequence": {
                          "type": "integer",
                          "example": 0
                        },
                        "maxParticipants": {
                          "type": "integer",
                          "example": 30
                        },
                        "currentParticipants": {
                          "type": "integer",
                          "example": 0
                        },
                        "status": {
                          "type": "string",
                          "example": "inactive"
                        },
                        "type": {
                          "type": "string",
                          "example": "workshop"
                        },
                        "creator": {
                          "type": "string",
                          "example": "admin_id"
                        },
                        "created": {
                          "type": "string",
                          "example": "2024-01-01 10:00:00"
                        },
                        "updated": {
                          "type": "string",
                          "example": "2024-01-01 10:00:00"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 10000,
                  "message": "活动创建成功",
                  "data": {
                    "id": "new_activity_id",
                    "title": "编程工作坊",
                    "description": "学习 JavaScript 基础知识",
                    "startTime": "2024-02-01T09:00:00Z",
                    "endTime": "2024-02-01T17:00:00Z",
                    "location": "北京市朝阳区",
                    "price": 299,
                    "coverImage": "",
                    "images": [],
                    "externalLink": "",
                    "tags": ["编程", "教育"],
                    "sequence": 0,
                    "maxParticipants": 30,
                    "currentParticipants": 0,
                    "status": "inactive",
                    "type": "workshop",
                    "creator": "admin_id",
                    "created": "2024-01-01 10:00:00",
                    "updated": "2024-01-01 10:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                },
                "examples": {
                  "empty_title": {
                    "summary": "标题为空",
                    "value": {
                      "code": 400,
                      "message": "活动标题不能为空",
                      "data": null
                    }
                  },
                  "empty_description": {
                    "summary": "描述为空",
                    "value": {
                      "code": 400,
                      "message": "活动描述不能为空",
                      "data": null
                    }
                  },
                  "empty_start_time": {
                    "summary": "开始时间为空",
                    "value": {
                      "code": 400,
                      "message": "活动开始时间不能为空",
                      "data": null
                    }
                  },
                  "empty_end_time": {
                    "summary": "结束时间为空",
                    "value": {
                      "code": 400,
                      "message": "活动结束时间不能为空",
                      "data": null
                    }
                  },
                  "empty_location": {
                    "summary": "地点为空",
                    "value": {
                      "code": 400,
                      "message": "活动地点不能为空",
                      "data": null
                    }
                  },
                  "empty_price": {
                    "summary": "价格为空",
                    "value": {
                      "code": 400,
                      "message": "活动价格不能为空",
                      "data": null
                    }
                  },
                  "invalid_price": {
                    "summary": "价格格式错误",
                    "value": {
                      "code": 400,
                      "message": "活动价格必须为非负数",
                      "data": null
                    }
                  },
                  "invalid_time_format": {
                    "summary": "时间格式错误",
                    "value": {
                      "code": 400,
                      "message": "开始时间格式不正确",
                      "data": null
                    }
                  },
                  "invalid_time_logic": {
                    "summary": "时间逻辑错误",
                    "value": {
                      "code": 400,
                      "message": "开始时间必须早于结束时间",
                      "data": null
                    }
                  },
                  "data_format_error": {
                    "summary": "数据格式错误",
                    "value": {
                      "code": 400,
                      "message": "数据格式错误，请检查输入",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未授权访问",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "未授权访问"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "权限不足（非管理员）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 403
                    },
                    "message": {
                      "type": "string",
                      "example": "权限不足"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 500
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                },
                "examples": {
                  "create_failed": {
                    "summary": "创建失败",
                    "value": {
                      "code": 500,
                      "message": "创建失败，请稍后重试",
                      "data": null
                    }
                  },
                  "server_error": {
                    "summary": "服务器异常",
                    "value": {
                      "code": 500,
                      "message": "服务器内部错误",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "管理员 JWT 令牌"
      }
    }
  }
} 