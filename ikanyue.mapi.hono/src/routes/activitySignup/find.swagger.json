{
  "paths": {
    "/v1/activity-signup/find": {
      "get": {
        "tags": ["Activity"],
        "summary": "查询我的报名记录",
        "description": "分页查询当前登录用户的活动报名记录",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "number", "example": 1 } },
          { "name": "perPage", "in": "query", "schema": { "type": "number", "example": 10 } },
          { "name": "status", "in": "query", "schema": { "type": "string", "example": "registered" } },
          { "name": "activityId", "in": "query", "schema": { "type": "string", "example": "activity_123" } }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "number", "example": 10000 },
          "message": { "type": ["string", "null"] },
          "data": { "type": ["object", "null"] }
        }
      }
    }
  }
}

