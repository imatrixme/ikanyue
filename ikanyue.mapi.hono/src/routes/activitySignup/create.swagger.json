{
  "paths": {
    "/v1/activity-signup": {
      "post": {
        "tags": ["Activity"],
        "summary": "活动报名",
        "description": "当前登录用户报名指定活动",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["activityId", "realName", "age"],
                "properties": {
                  "activityId": { "type": "string", "example": "activity_123" },
                  "realName": { "type": "string", "example": "张三" },
                  "age": { "type": "number", "example": 12 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "报名成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "number", "example": 10000 },
          "message": { "type": ["string", "null"] },
          "data": { "type": ["object", "null"] }
        }
      }
    }
  }
}

