{
  "openapi": "3.0.0",
  "info": {
    "title": "更新视频材料",
    "version": "1.0.0",
    "description": "更新现有视频材料的信息，支持修改标题、类型、描述、视频源、内容等所有字段，需要教师权限"
  },
  "paths": {
    "/v1/videoMaterial/update": {
      "post": {
        "summary": "更新视频材料",
        "description": "更新现有视频材料的信息，支持部分字段更新",
        "tags": ["VideoMaterial"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "description": "视频材料更新数据",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "视频材料ID",
                    "example": "v7c3q8yq1wksd3z"
                  },
                  "title": {
                    "type": "string",
                    "description": "视频材料标题",
                    "example": "高级商务英语视频教程"
                  },
                  "type": {
                    "type": "string",
                    "description": "视频类型",
                    "example": "advanced_tutorial"
                  },
                  "description": {
                    "type": "string",
                    "description": "视频描述",
                    "example": "适合高级学员的商务英语视频教程"
                  },
                  "videoSource": {
                    "type": "string",
                    "format": "uri",
                    "description": "视频源URL",
                    "example": "https://example.com/videos/advanced_business_english.mp4"
                  },
                  "content": {
                    "type": "string",
                    "description": "视频内容描述",
                    "example": "包含商务谈判、会议主持等高级场景"
                  },
                  "publishedAt": {
                    "type": "string",
                    "format": "date",
                    "description": "发布时间",
                    "example": "2024-01-15"
                  },
                  "author": {
                    "type": "string",
                    "description": "作者",
                    "example": "李老师"
                  },
                  "duration": {
                    "type": "number",
                    "description": "视频时长（秒）",
                    "minimum": 0,
                    "example": 1800
                  },
                  "sequence": {
                    "type": "number",
                    "description": "排序序号",
                    "minimum": 0,
                    "example": 5
                  },
                  "status": {
                    "type": "string",
                    "enum": ["draft", "published"],
                    "description": "状态",
                    "example": "published"
                  },
                  "coverImage": {
                    "type": "string",
                    "format": "uri",
                    "description": "封面图片URL",
                    "example": "https://example.com/covers/advanced_cover.jpg"
                  },
                  "language": {
                    "type": "string",
                    "enum": ["中文", "英文"],
                    "description": "语言",
                    "example": "英文"
                  },
                  "difficulty": {
                    "type": "number",
                    "description": "难度等级（1-5）",
                    "minimum": 1,
                    "maximum": 5,
                    "example": 4
                  },
                  "tags": {
                    "type": "string",
                    "description": "标签",
                    "example": "商务英语,高级,谈判"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p", "1080p", "4k"],
                    "description": "视频分辨率",
                    "example": "4k"
                  },
                  "subtitles": {
                    "type": "string",
                    "format": "uri",
                    "description": "字幕文件URL",
                    "example": "https://example.com/subtitles/advanced_en.srt"
                  }
                }
              },
              "example": {
                "id": "v7c3q8yq1wksd3z",
                "title": "高级商务英语视频教程",
                "description": "适合高级学员的商务英语视频教程",
                "duration": 1800,
                "difficulty": 4,
                "status": "published",
                "resolution": "4k"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "视频材料更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 10000
                    },
                    "message": {
                      "type": "string",
                      "example": "视频材料更新成功"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "视频材料ID"
                        },
                        "title": {
                          "type": "string",
                          "description": "视频材料标题"
                        },
                        "type": {
                          "type": "string",
                          "description": "视频类型"
                        },
                        "description": {
                          "type": "string",
                          "description": "视频描述"
                        },
                        "videoSource": {
                          "type": "string",
                          "description": "视频源URL"
                        },
                        "content": {
                          "type": "string",
                          "description": "视频内容"
                        },
                        "publishedAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "发布时间"
                        },
                        "author": {
                          "type": "string",
                          "description": "作者"
                        },
                        "duration": {
                          "type": "number",
                          "description": "视频时长（秒）"
                        },
                        "sequence": {
                          "type": "number",
                          "description": "排序序号"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["draft", "published"],
                          "description": "状态"
                        },
                        "language": {
                          "type": "string",
                          "enum": ["中文", "英文"],
                          "description": "语言"
                        },
                        "difficulty": {
                          "type": "number",
                          "description": "难度等级"
                        },
                        "tags": {
                          "type": "string",
                          "description": "标签"
                        },
                        "coverImage": {
                          "type": "string",
                          "description": "封面图片URL"
                        },
                        "resolution": {
                          "type": "string",
                          "enum": ["480p", "720p", "1080p", "4k"],
                          "description": "视频分辨率"
                        },
                        "subtitles": {
                          "type": "string",
                          "description": "字幕文件URL"
                        },
                        "created": {
                          "type": "string",
                          "format": "date-time",
                          "description": "创建时间"
                        },
                        "updated": {
                          "type": "string",
                          "format": "date-time",
                          "description": "更新时间"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 10000,
                  "message": "视频材料更新成功",
                  "data": {
                    "id": "v7c3q8yq1wksd3z",
                    "title": "高级商务英语视频教程",
                    "type": "advanced_tutorial",
                    "description": "适合高级学员的商务英语视频教程",
                    "videoSource": "https://example.com/videos/advanced_business_english.mp4",
                    "content": "包含商务谈判、会议主持等高级场景",
                    "publishedAt": "2024-01-15T00:00:00.000Z",
                    "author": "李老师",
                    "duration": 1800,
                    "sequence": 5,
                    "status": "published",
                    "coverImage": "https://example.com/covers/advanced_cover.jpg",
                    "language": "英文",
                    "difficulty": 4,
                    "tags": "商务英语,高级,谈判",
                    "resolution": "4k",
                    "subtitles": "https://example.com/subtitles/advanced_en.srt",
                    "created": "2024-12-26T10:00:00.000Z",
                    "updated": "2024-12-26T15:30:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40001
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                },
                "examples": {
                  "idEmpty": {
                    "summary": "ID为空",
                    "value": {
                      "code": 40001,
                      "message": "视频材料ID不能为空",
                      "data": null
                    }
                  },
                  "noUpdateFields": {
                    "summary": "无更新字段",
                    "value": {
                      "code": 40001,
                      "message": "没有提供要更新的字段",
                      "data": null
                    }
                  },
                  "titleEmpty": {
                    "summary": "标题为空",
                    "value": {
                      "code": 40001,
                      "message": "视频材料标题不能为空",
                      "data": null
                    }
                  },
                  "difficultyInvalid": {
                    "summary": "难度等级错误",
                    "value": {
                      "code": 40001,
                      "message": "难度等级必须为1-5之间的整数",
                      "data": null
                    }
                  },
                  "resolutionInvalid": {
                    "summary": "分辨率选项错误",
                    "value": {
                      "code": 40001,
                      "message": "分辨率只能是'480p'、'720p'、'1080p'或'4k'",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40101
                    },
                    "message": {
                      "type": "string",
                      "example": "认证失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40301
                    },
                    "message": {
                      "type": "string",
                      "example": "需要教师权限"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "视频材料不存在",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40401
                    },
                    "message": {
                      "type": "string",
                      "example": "视频材料不存在"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 50001
                    },
                    "message": {
                      "type": "string",
                      "example": "更新视频材料失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
} 