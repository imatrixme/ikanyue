{
  "openapi": "3.0.0",
  "info": {
    "title": "学生查询接口",
    "version": "1.0.0",
    "description": "分页查询学生列表，支持按手机号和昵称进行模糊搜索，用于教师管理学生信息。提供完整的分页功能和数据安全保护。"
  },
  "paths": {
    "/v1/student/find": {
      "get": {
        "summary": "查询学生列表",
        "description": "分页查询学生信息，支持手机号和昵称的模糊搜索。需要教师权限，自动过滤敏感字段。",
        "tags": ["Student"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "页码，从1开始",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页数量，最大100",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 20
            }
          },
          {
            "name": "cellphone",
            "in": "query",
            "description": "手机号模糊搜索",
            "required": false,
            "schema": {
              "type": "string",
              "example": "138"
            }
          },
          {
            "name": "nickName",
            "in": "query",
            "description": "昵称模糊搜索",
            "required": false,
            "schema": {
              "type": "string",
              "example": "张三"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentListResponse"
                },
                "example": {
                  "code": 10000,
                  "message": "查询成功",
                  "data": {
                    "items": [
                      {
                        "id": "student_67894a2b-f8c7-4b2a-9d1e-3456789abcde",
                        "sn": "sn_unique_id_12345",
                        "cellphone": "13800138000",
                        "nickName": "张三",
                        "avatar": "https://example.com/avatar.jpg",
                        "realName": "张三丰",
                        "gender": 1,
                        "birthday": "1990-01-01",
                        "blocked": false,
                        "lastLoginAt": "2024-12-26 10:00:00.000Z",
                        "created": "2024-12-26 09:00:00.000Z",
                        "updated": "2024-12-26 10:00:00.000Z"
                      },
                      {
                        "id": "student_67894a2b-f8c7-4b2a-9d1e-3456789abcdf",
                        "sn": "sn_unique_id_12346",
                        "cellphone": "13800138001",
                        "nickName": "李四",
                        "avatar": "https://example.com/avatar2.jpg",
                        "realName": "李四光",
                        "gender": 1,
                        "birthday": "1992-03-15",
                        "blocked": false,
                        "lastLoginAt": "2024-12-26 11:00:00.000Z",
                        "created": "2024-12-26 08:30:00.000Z",
                        "updated": "2024-12-26 11:00:00.000Z"
                      }
                    ],
                    "totalItems": 50,
                    "totalPages": 5,
                    "page": 1,
                    "perPage": 10
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidParams": {
                    "summary": "参数格式错误",
                    "value": {
                      "code": 400,
                      "message": "页码和每页数量必须为正整数",
                      "data": null
                    }
                  },
                  "limitExceeded": {
                    "summary": "数量超限",
                    "value": {
                      "code": 400,
                      "message": "每页数量不能超过100",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "认证失败",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "权限不足，需要教师权限",
                  "data": null
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "queryFailed": {
                    "summary": "查询失败",
                    "value": {
                      "code": 500,
                      "message": "查询失败，请稍后重试",
                      "data": null
                    }
                  },
                  "serverError": {
                    "summary": "系统异常",
                    "value": {
                      "code": 500,
                      "message": "服务器内部错误",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StudentItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "学生 ID",
            "example": "student_67894a2b-f8c7-4b2a-9d1e-3456789abcde"
          },
          "sn": {
            "type": "string",
            "description": "学生序列号",
            "example": "sn_unique_id_12345"
          },
          "cellphone": {
            "type": "string",
            "description": "手机号",
            "example": "13800138000"
          },
          "nickName": {
            "type": "string",
            "description": "昵称",
            "example": "张三"
          },
          "avatar": {
            "type": "string",
            "description": "头像 URL",
            "example": "https://example.com/avatar.jpg"
          },
          "realName": {
            "type": "string",
            "description": "真实姓名",
            "example": "张三丰"
          },
          "gender": {
            "type": "integer",
            "description": "性别 (0:未知，1:男，2:女)",
            "example": 1
          },
          "birthday": {
            "type": "string",
            "format": "date",
            "description": "生日",
            "example": "1990-01-01"
          },
          "blocked": {
            "type": "boolean",
            "description": "是否被封禁",
            "example": false
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "description": "最后登录时间",
            "example": "2024-12-26 10:00:00.000Z"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间",
            "example": "2024-12-26 09:00:00.000Z"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "description": "更新时间",
            "example": "2024-12-26 10:00:00.000Z"
          }
        }
      },
      "StudentListData": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StudentItem"
            },
            "description": "学生列表"
          },
          "totalItems": {
            "type": "integer",
            "description": "总记录数",
            "example": 50
          },
          "totalPages": {
            "type": "integer",
            "description": "总页数",
            "example": 5
          },
          "page": {
            "type": "integer",
            "description": "当前页码",
            "example": 1
          },
          "perPage": {
            "type": "integer",
            "description": "每页数量",
            "example": 10
          }
        }
      },
      "StudentListResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "example": "查询成功"
          },
          "data": {
            "$ref": "#/components/schemas/StudentListData"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "null",
            "example": null
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "需要教师权限的 JWT Token"
      }
    }
  },
  "tags": [
    {
      "name": "Student",
      "description": "学生管理相关接口"
    }
  ]
} 