{
  "openapi": "3.0.0",
  "info": {
    "title": "更新学生信息",
    "version": "1.0.0",
    "description": "更新学生信息接口，支持修改学生的基本信息，包括个人资料、密码等。具有安全字段保护机制。"
  },
  "paths": {
    "/v1/student/update": {
      "post": {
        "summary": "更新学生信息",
        "description": "更新指定学生的基本信息。会自动过滤敏感字段，支持密码修改时的自动加密。",
        "tags": ["Student"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStudentRequest"
              },
              "example": {
                "id": "student_67894a2b-f8c7-4b2a-9d1e-3456789abcde",
                "realname": "张三",
                "nickName": "小张",
                "avatar": "https://example.com/new_avatar.jpg",
                "gender": 1,
                "age": 21,
                "province": "广东省",
                "city": "深圳市",
                "address": "南山区科技园B座",
                "password": "newpassword123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateStudentResponse"
                },
                "example": {
                  "code": 10000,
                  "message": null,
                  "data": {
                    "id": "student_67894a2b-f8c7-4b2a-9d1e-3456789abcde",
                    "sn": "sn_unique_id_12345",
                    "cellphone": "13800138000",
                    "realname": "张三",
                    "nickName": "小张",
                    "avatar": "https://example.com/new_avatar.jpg",
                    "gender": 1,
                    "age": 21,
                    "province": "广东省",
                    "city": "深圳市",
                    "address": "南山区科技园B座",
                    "hours": 0,
                    "blocked": false,
                    "created": "2024-12-26 09:00:00.000Z",
                    "updated": "2024-12-26 10:30:15.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "message": "缺少学生ID",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "认证失败",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "学生不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 404,
                  "message": "学生不存在",
                  "data": null
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "updateFailed": {
                    "summary": "更新失败",
                    "value": {
                      "code": 500,
                      "message": "更新学生信息失败",
                      "data": null
                    }
                  },
                  "serverError": {
                    "summary": "系统异常",
                    "value": {
                      "code": 500,
                      "message": "服务器内部错误",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateStudentRequest": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "学生记录ID",
            "example": "student_67894a2b-f8c7-4b2a-9d1e-3456789abcde"
          },
          "realname": {
            "type": "string",
            "description": "真实姓名",
            "example": "张三"
          },
          "nickName": {
            "type": "string",
            "description": "昵称",
            "example": "小张"
          },
          "avatar": {
            "type": "string",
            "description": "头像 URL",
            "format": "uri",
            "example": "https://example.com/avatar.jpg"
          },
          "gender": {
            "type": "integer",
            "description": "性别 (0:未知，1:男，2:女)",
            "enum": [0, 1, 2],
            "example": 1
          },
          "age": {
            "type": "integer",
            "description": "年龄",
            "minimum": 1,
            "maximum": 150,
            "example": 21
          },
          "province": {
            "type": "string",
            "description": "省份",
            "example": "广东省"
          },
          "city": {
            "type": "string",
            "description": "城市",
            "example": "深圳市"
          },
          "address": {
            "type": "string",
            "description": "地址",
            "example": "南山区科技园B座"
          },
          "password": {
            "type": "string",
            "description": "新密码（可选，会自动加密）",
            "minLength": 6,
            "example": "newpassword123"
          }
        }
      },
      "UpdatedStudentData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "学生 ID"
          },
          "sn": {
            "type": "string",
            "description": "学生序列号"
          },
          "cellphone": {
            "type": "string",
            "description": "手机号"
          },
          "realname": {
            "type": "string",
            "description": "真实姓名"
          },
          "nickName": {
            "type": "string",
            "description": "昵称"
          },
          "avatar": {
            "type": "string",
            "description": "头像 URL"
          },
          "gender": {
            "type": "integer",
            "description": "性别 (0:未知，1:男，2:女)"
          },
          "age": {
            "type": "integer",
            "description": "年龄"
          },
          "province": {
            "type": "string",
            "description": "省份"
          },
          "city": {
            "type": "string",
            "description": "城市"
          },
          "address": {
            "type": "string",
            "description": "地址"
          },
          "hours": {
            "type": "number",
            "description": "课时"
          },
          "blocked": {
            "type": "boolean",
            "description": "是否被屏蔽"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "description": "更新时间"
          }
        }
      },
      "UpdateStudentResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "data": {
            "$ref": "#/components/schemas/UpdatedStudentData"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "null",
            "example": null
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "需要认证的 JWT Token"
      }
    }
  },
  "tags": [
    {
      "name": "Student",
      "description": "学生管理相关接口"
    }
  ]
} 