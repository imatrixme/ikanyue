{
  "openapi": "3.0.0",
  "info": {
    "title": "用户统一登录接口",
    "version": "1.0.0",
    "description": "统一的用户登录接口，支持学生和教师登录。先查学生再查教师；未注册的手机号返回 401，不自动注册。返回数据不含密码哈希、tokenKey 和微信身份标识；同一手机号 15 分钟内失败 5 次返回 429。"
  },
  "paths": {
    "/v1/user/login": {
      "post": {
        "summary": "用户登录",
        "description": "统一登录接口，支持学生和教师登录；未注册手机号返回 401",
        "tags": [
          "User"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "cellphone",
                  "password"
                ],
                "properties": {
                  "cellphone": {
                    "type": "string",
                    "description": "手机号，必传",
                    "example": "13800138000",
                    "pattern": "^1[3-9]\\d{9}$"
                  }
                }
              },
              "example": {
                "cellphone": "13800138000"
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cellphone",
                  "password"
                ],
                "properties": {
                  "cellphone": {
                    "type": "string",
                    "description": "手机号，必传",
                    "example": "13800138000",
                    "pattern": "^1[3-9]\\d{9}$"
                  }
                }
              },
              "example": {
                "cellphone": "13800138000"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 10000
                    },
                    "message": {
                      "type": "null",
                      "example": null
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserLoginResponse"
                    }
                  }
                },
                "examples": {
                  "student_login": {
                    "summary": "学生登录成功",
                    "value": {
                      "code": 10000,
                      "message": null,
                      "data": {
                        "id": "student_record_id",
                        "sn": "unique_student_sn",
                        "cellphone": "13800138000",
                        "role": "student",
                        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                        "isAdmin": false,
                        "avatar": "https://example.com/default-avatar.jpg",
                        "nickName": "用户8000",
                        "gender": 0,
                        "blocked": false,
                        "lastLoginAt": "2024-01-01T10:00:00.000Z",
                        "lastLoginMethod": "password"
                      }
                    }
                  },
                  "teacher_login": {
                    "summary": "教师登录成功",
                    "value": {
                      "code": 10000,
                      "message": null,
                      "data": {
                        "id": "teacher_record_id",
                        "sn": "unique_teacher_sn",
                        "cellphone": "13800138001",
                        "role": "teacher",
                        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                        "isAdmin": true,
                        "avatar": "https://example.com/teacher-avatar.jpg",
                        "nickName": "张老师",
                        "verified": true,
                        "blocked": false,
                        "lastLoginAt": "2024-01-01T10:00:00.000Z",
                        "lastLoginMethod": "password"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "手机号和密码不能为空"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "手机号或密码错误"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "账户状态异常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 403
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                },
                "examples": {
                  "blocked_account": {
                    "summary": "账户被封禁",
                    "value": {
                      "code": 403,
                      "message": "该账号已被封禁，请联系客服",
                      "data": null
                    }
                  },
                  "unverified_teacher": {
                    "summary": "教师账户未审核",
                    "value": {
                      "code": 403,
                      "message": "账号正在审核中，请耐心等待",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 500
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                },
                "examples": {
                  "create_failed": {
                    "summary": "创建学生失败",
                    "value": {
                      "code": 500,
                      "message": "创建学生失败",
                      "data": null
                    }
                  },
                  "server_error": {
                    "summary": "服务器异常",
                    "value": {
                      "code": 500,
                      "message": "服务器内部错误",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserLoginResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户记录ID",
            "example": "record_id"
          },
          "sn": {
            "type": "string",
            "description": "用户唯一标识符",
            "example": "unique_sn"
          },
          "cellphone": {
            "type": "string",
            "description": "手机号",
            "example": "13800138000"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "teacher"
            ],
            "description": "用户角色",
            "example": "student"
          },
          "token": {
            "type": "string",
            "description": "JWT 认证令牌",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "isAdmin": {
            "type": "boolean",
            "description": "是否为管理员",
            "example": false
          },
          "avatar": {
            "type": "string",
            "format": "uri",
            "description": "用户头像URL",
            "example": "https://example.com/default-avatar.jpg"
          },
          "nickName": {
            "type": "string",
            "description": "用户昵称",
            "example": "用户8000"
          },
          "gender": {
            "type": "integer",
            "description": "性别 (0: 未知, 1: 男, 2: 女)",
            "example": 0,
            "enum": [
              0,
              1,
              2
            ]
          },
          "blocked": {
            "type": "boolean",
            "description": "是否被封禁",
            "example": false
          },
          "verified": {
            "type": "boolean",
            "description": "是否已审核（仅教师）",
            "example": true
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "description": "最后登录时间",
            "example": "2024-01-01T10:00:00.000Z"
          },
          "lastLoginMethod": {
            "type": "string",
            "description": "最后登录方式",
            "example": "password"
          }
        },
        "required": [
          "id",
          "sn",
          "cellphone",
          "role",
          "token",
          "isAdmin"
        ]
      }
    }
  }
}
