{
  "openapi": "3.0.0",
  "info": {
    "title": "更新用户信息",
    "version": "1.0.0",
    "description": "更新用户信息接口，允许已认证用户修改自己的个人信息，如姓名、头像等非敏感数据"
  },
  "paths": {
    "/v1/user/update": {
      "post": {
        "summary": "更新用户信息",
        "description": "允许已认证用户修改自己的个人信息，如姓名、头像等非敏感数据",
        "tags": ["User"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "description": "用户信息更新数据",
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "用户姓名",
                    "maxLength": 255
                  },
                  "avatar": {
                    "type": "string",
                    "description": "头像文件",
                    "format": "binary"
                  }
                }
              },
              "example": {
                "name": "张三丰",
                "avatar": "https://example.com/avatar.jpg"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "用户信息更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 10000
                    },
                    "message": {
                      "type": "string",
                      "nullable": true,
                      "example": null
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "用户ID"
                        },
                        "email": {
                          "type": "string",
                          "description": "用户邮箱"
                        },
                        "name": {
                          "type": "string",
                          "description": "用户姓名"
                        },
                        "avatar": {
                          "type": "string",
                          "description": "用户头像URL"
                        },
                        "emailVisibility": {
                          "type": "boolean",
                          "description": "邮箱可见性"
                        },
                        "verified": {
                          "type": "boolean",
                          "description": "邮箱验证状态"
                        },
                        "created": {
                          "type": "string",
                          "format": "date-time",
                          "description": "创建时间"
                        },
                        "updated": {
                          "type": "string",
                          "format": "date-time",
                          "description": "更新时间"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 10000,
                  "message": null,
                  "data": {
                    "id": "u7c3q8yq1wksd3z",
                    "email": "test@example.com",
                    "name": "张三丰",
                    "avatar": "https://example.com/avatar.jpg",
                    "emailVisibility": true,
                    "verified": true,
                    "created": "2024-12-26T10:00:00.000Z",
                    "updated": "2024-12-26T10:08:12.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40001
                    },
                    "message": {
                      "type": "string",
                      "example": "参数验证失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null"
                    }
                  }
                },
                "examples": {
                  "authFailed": {
                    "summary": "认证失败",
                    "value": {
                      "code": 40101,
                      "message": "认证失败",
                      "data": null
                    }
                  },
                  "tokenExpired": {
                    "summary": "令牌过期",
                    "value": {
                      "code": 40102,
                      "message": "令牌过期",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 50001
                    },
                    "message": {
                      "type": "string",
                      "example": "更新用户信息失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
} 