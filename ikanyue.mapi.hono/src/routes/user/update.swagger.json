{
  "openapi": "3.0.0",
  "info": {
    "title": "更新用户信息",
    "version": "1.0.0",
    "description": "更新用户信息接口，允许已认证用户修改自己的个人信息，如姓名、头像等非敏感数据"
  },
  "paths": {
    "/v1/user/update": {
      "post": {
        "summary": "更新用户信息",
        "description": "允许已认证用户修改自己的个人信息，如姓名、头像等非敏感数据",
        "tags": ["User"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "description": "用户信息更新数据",
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickName": {
                    "type": "string",
                    "description": "昵称；兼容旧字段 nickname",
                    "maxLength": 24
                  },
                  "realName": {
                    "type": "string",
                    "description": "真实姓名；兼容旧字段 realname",
                    "maxLength": 24
                  },
                  "avatar": {
                    "type": "string",
                    "description": "头像 URL"
                  },
                  "gender": {
                    "type": "integer",
                    "enum": [0, 1, 2]
                  },
                  "age": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120
                  },
                  "province": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "nickName": "小张",
                "realName": "张三",
                "gender": 1,
                "age": 18,
                "province": "广东省"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "用户信息更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 10000
                    },
                    "message": {
                      "type": "string",
                      "nullable": true,
                      "example": null
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "用户ID"
                        },
                        "cellphone": {
                          "type": "string",
                          "description": "绑定手机号"
                        },
                        "nickName": {
                          "type": "string",
                          "description": "规范昵称字段"
                        },
                        "nickname": {
                          "type": "string",
                          "description": "兼容旧昵称字段，与 nickName 一致"
                        },
                        "realName": {
                          "type": "string",
                          "description": "规范真实姓名字段"
                        },
                        "realname": {
                          "type": "string",
                          "description": "兼容旧真实姓名字段，与 realName 一致"
                        },
                        "avatar": {
                          "type": "string",
                          "description": "用户头像URL"
                        },
                        "gender": {
                          "type": "integer"
                        },
                        "age": {
                          "type": "integer"
                        },
                        "province": {
                          "type": "string"
                        },
                        "updated": {
                          "type": "string",
                          "format": "date-time",
                          "description": "更新时间"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 10000,
                  "message": null,
                  "data": {
                    "id": "u7c3q8yq1wksd3z",
                    "cellphone": "13800138000",
                    "nickName": "小张",
                    "nickname": "小张",
                    "realName": "张三",
                    "realname": "张三",
                    "avatar": "https://example.com/avatar.jpg",
                    "gender": 1,
                    "age": 18,
                    "province": "广东省",
                    "updated": "2024-12-26T10:08:12.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40001
                    },
                    "message": {
                      "type": "string",
                      "example": "参数验证失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null"
                    }
                  }
                },
                "examples": {
                  "authFailed": {
                    "summary": "认证失败",
                    "value": {
                      "code": 40101,
                      "message": "认证失败",
                      "data": null
                    }
                  },
                  "tokenExpired": {
                    "summary": "令牌过期",
                    "value": {
                      "code": 40102,
                      "message": "令牌过期",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 50001
                    },
                    "message": {
                      "type": "string",
                      "example": "更新用户信息失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
} 
