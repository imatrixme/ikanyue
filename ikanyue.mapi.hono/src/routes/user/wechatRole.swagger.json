{
  "openapi": "3.0.0",
  "info": { "title": "微信多身份接口", "version": "2.1.0" },
  "paths": {
    "/v1/user/wechat-role-login": {
      "post": {
        "summary": "完成微信登录身份选择",
        "tags": ["User"],
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WechatRoleChallenge" } } } },
        "responses": { "200": { "$ref": "#/components/responses/WechatRoleResponse" } }
      }
    },
    "/v1/user/wechat-roles": {
      "get": {
        "summary": "查询当前微信可切换身份",
        "tags": ["User"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/WechatRoleResponse" } }
      }
    },
    "/v1/user/switch-wechat-role": {
      "post": {
        "summary": "切换已绑定的学员或教师身份",
        "tags": ["User"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WechatRoleSwitch" } } } },
        "responses": { "200": { "$ref": "#/components/responses/WechatRoleResponse" } }
      }
    }
  },
  "components": {
    "responses": {
      "WechatRoleResponse": { "description": "身份列表或登录主体", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WechatRoleEnvelope" } } } }
    },
    "schemas": {
      "WechatRoleChallenge": { "type": "object", "required": ["challenge", "role"], "properties": { "challenge": { "type": "string" }, "role": { "type": "string", "enum": ["student", "teacher"] } } },
      "WechatRoleSwitch": { "type": "object", "required": ["role"], "properties": { "role": { "type": "string", "enum": ["student", "teacher"] } } },
      "WechatRoleEnvelope": { "type": "object", "properties": { "code": { "type": "integer" }, "message": { "type": "string", "nullable": true }, "data": { "nullable": true } } }
    }
  }
}
