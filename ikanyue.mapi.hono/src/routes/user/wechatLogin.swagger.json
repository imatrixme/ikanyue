{
  "openapi": "3.0.0",
  "info": {
    "title": "微信授权登录接口",
    "version": "1.0.0",
    "description": "通过微信小程序授权（头像/昵称 + 手机号）完成一键注册登录"
  },
  "paths": {
    "/v1/user/wechat-login": {
      "post": {
        "summary": "微信授权登录",
        "description": "校验微信 code、解密手机号并创建/更新学生账号，返回 JWT",
        "tags": ["User"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WechatLoginRequest" },
              "example": {
                "code": "081sZK0000klhC2kYM300f0Pua0sZK1h",
                "userInfo": {
                  "nickName": "小明",
                  "avatarUrl": "https://example.com/avatar.jpg",
                  "gender": 1
                },
                "phone": {
                  "encryptedData": "SOME_BASE64_DATA",
                  "iv": "SOME_IV_VALUE"
                },
                "rawData": "{\"nickName\":\"小明\"}",
                "signature": "c4d5dbb4f43c28f5f1f03296d706c9ef0e69a4ac"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/WechatLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 10000 },
                    "message": { "type": "null", "example": null },
                    "data": { "$ref": "#/components/schemas/WechatLoginResponse" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WechatLoginRequest": {
        "type": "object",
        "required": ["code", "phone"],
        "properties": {
          "code": {
            "type": "string",
            "description": "wx.login 返回的 code"
          },
          "userInfo": {
            "type": "object",
            "description": "getUserProfile 返回的数据",
            "properties": {
              "nickName": { "type": "string" },
              "avatarUrl": { "type": "string", "format": "uri" },
              "gender": { "type": "integer", "enum": [0, 1, 2] },
              "language": { "type": "string" },
              "city": { "type": "string" },
              "province": { "type": "string" },
              "country": { "type": "string" }
            }
          },
          "phone": {
            "type": "object",
            "required": ["encryptedData", "iv"],
            "properties": {
              "encryptedData": {
                "type": "string",
                "description": "getPhoneNumber 返回的加密数据"
              },
              "iv": {
                "type": "string",
                "description": "getPhoneNumber 返回的初始向量"
              }
            }
          },
          "rawData": {
            "type": "string",
            "description": "微信返回的原始用户信息（可选）"
          },
          "signature": {
            "type": "string",
            "description": "rawData 对应的签名（可选）"
          }
        }
      },
      "WechatLoginResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sn": { "type": "string" },
          "cellphone": { "type": "string" },
          "role": { "type": "string", "enum": ["student"] },
          "token": { "type": "string" },
          "nickName": { "type": "string" },
          "avatar": { "type": "string", "format": "uri" },
          "wechatId": { "type": "string" },
          "wechatUnionId": { "type": "string" },
          "lastLoginAt": { "type": "string", "format": "date-time" },
          "lastLoginIp": { "type": "string" },
          "lastLoginMethod": {
            "type": "string",
            "enum": ["wechat"],
            "example": "wechat"
          },
          "isAdmin": { "type": "boolean", "example": false }
        },
        "required": ["id", "sn", "cellphone", "role", "token", "isAdmin"]
      }
    }
  }
}
