{
  "openapi": "3.0.3",
  "info": { "title": "Commerce Operations", "version": "1.0.0" },
  "components": {
    "parameters": {
      "CommerceId": { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "CommerceResult": { "description": "Business envelope: code=10000 success, other codes are failures; data contains the result. All monetary values are integer CNY fen. Ops routes require finance capability and a completed password change." }
    },
    "schemas": {
      "CommerceReason": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 2, "maxLength": 500 } } },
      "CommerceRecovery": { "allOf": [{ "$ref": "#/components/schemas/CommerceReason" }, { "type": "object", "required": ["key"], "properties": { "key": { "type": "string", "maxLength": 100 } } }] },
      "CommerceAdminRefund": { "allOf": [{ "$ref": "#/components/schemas/CommerceRecovery" }, { "type": "object", "required": ["expectedAmount"], "properties": { "expectedAmount": { "type": "integer", "minimum": 1, "description": "Unchanged server quote. Clients cannot set the refund amount." } } }] },
      "CommerceOfferDraft": { "type": "object", "required": ["key", "name", "packageId", "priceVersionId", "policy"], "properties": {
        "key": { "type": "string" }, "id": { "type": "string" }, "version": { "type": "integer" }, "name": { "type": "string" }, "packageId": { "type": "string" }, "priceVersionId": { "type": "string" },
        "policy": { "type": "object", "required": ["version", "packageRefund", "cancellationTiers"], "properties": {
          "version": { "type": "integer", "minimum": 1 }, "packageRefund": { "type": "string", "enum": ["unused_paid_value"] }, "reservationRefund": { "type": "string", "enum": ["cash"] },
          "cancellationTiers": { "type": "array", "minItems": 1, "description": "Descending beforeMinutes, nondecreasing feeBps, last threshold zero; start-time equality is inclusive.", "items": { "type": "object", "required": ["beforeMinutes", "feeBps"], "properties": { "beforeMinutes": { "type": "integer", "minimum": 0 }, "feeBps": { "type": "integer", "minimum": 0, "maximum": 10000 } } } }
        } }
      } },
      "CommerceStatementImport": { "type": "object", "required": ["date", "content"], "properties": { "date": { "type": "string", "format": "date" }, "content": { "type": "string", "description": "Official ALL trade bill, up to 1MB. Manual imports retain unverified provenance." } } },
      "CommerceBankEvidence": { "type": "object", "required": ["date", "amount", "reference", "evidenceHash"], "properties": { "date": { "type": "string", "format": "date" }, "amount": { "type": "integer", "minimum": 0 }, "reference": { "type": "string" }, "evidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Bank receipt SHA-256. Finance retains the original; not automatic bank verification." } } }
    }
  },
  "paths": {
    "/ops/commerce/orders": { "get": { "summary": "Search business orders by learner name, phone, course or order ID", "security": [{ "bearerAuth": [] }], "parameters": [
      { "in": "query", "name": "search", "schema": { "type": "string" } }, { "in": "query", "name": "status", "schema": { "type": "string", "enum": ["pending", "granting", "completed", "failed", "refunding"] } },
      { "in": "query", "name": "page", "schema": { "type": "integer", "minimum": 1 } }, { "in": "query", "name": "perPage", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
      { "in": "query", "name": "from", "schema": { "type": "string", "format": "date" }, "description": "Inclusive Asia/Shanghai calendar date" }, { "in": "query", "name": "to", "schema": { "type": "string", "format": "date" } }
    ], "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/orders/{id}": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "get": { "summary": "Order, credits, refund quote, gateway state and actor audit", "security": [{ "bearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/orders/{id}/refunds": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Refund remaining unused package credits with authenticated actor audit", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommerceAdminRefund" } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/orders/{id}/recover": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Reload trusted payment/refund results without fabricating success", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommerceRecovery" } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/refunds/{id}/retry": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Retry a definitively failed reservation refund; ambiguous outcomes cannot start another attempt", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommerceReason" } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/offers": {
      "get": { "summary": "Offers, packages and immutable price references", "security": [{ "bearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } },
      "post": { "summary": "Create or update an unpublished offer draft", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommerceOfferDraft" } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } }
    },
    "/ops/commerce/offers/{id}/status": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Publish draft or withdraw active version; published rules cannot be edited", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/CommerceReason" }, { "type": "object", "required": ["version", "status"], "properties": { "version": { "type": "integer" }, "status": { "type": "string", "enum": ["active", "inactive"] } } }] } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/cases": { "get": { "summary": "Current financial exceptions and saved case history", "security": [{ "bearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/cases/{id}": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Save case note or resolve only after underlying state is verified", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["note", "status"], "properties": { "note": { "type": "string", "minLength": 2, "maxLength": 500 }, "status": { "type": "string", "enum": ["open", "resolved"] } } } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/recovery-work": { "get": { "summary": "Persistent exhausted payment recovery tasks", "security": [{ "bearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/recovery-work/{id}/retry": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Audited reset of an exhausted task", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommerceReason" } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/statements": { "get": { "summary": "Imported trade statements, fees and provenance", "security": [{ "bearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/statements/download": { "post": { "summary": "Download, verify and match a WeChat ALL bill; live dates must be historical", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["date"], "properties": { "date": { "type": "string", "format": "date" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/statements/import": { "post": { "summary": "Import a manually obtained ALL bill without claiming verified channel provenance", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommerceStatementImport" } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/statements/{id}": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "get": { "summary": "Matched lines, missing payments/refunds and bank evidence", "security": [{ "bearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/statements/{id}/export": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "get": { "summary": "CSV report in data.content; cells are formula-escaped", "security": [{ "bearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/statements/{id}/settlement": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Record finance-attested bank receipt, separately from trade totals", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommerceBankEvidence" } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/ops/commerce/statement-lines/{id}/resolve": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Recheck a discrepancy and retain an immutable resolution audit", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["note"], "properties": { "note": { "type": "string", "minLength": 2, "maxLength": 500 } } } } } }, "responses": { "200": { "$ref": "#/components/responses/CommerceResult" } } } },
    "/v1/student/appointments/{appointmentId}/cancellation-preview": { "get": { "summary": "Owned appointment cancellation quote, available independently of the commerce feature flag", "security": [{ "bearerAuth": [] }], "parameters": [{ "in": "path", "name": "appointmentId", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Business envelope data: mode=credit|cash, amount, fee, quantity; cash adds paid, currency, receivedAt and policyVersion. Cancel must echo expectedRefundAmount and expectedFee. Server reception time controls the inclusive tier." } } } },
    "/v1/student/commerce/orders/{id}/cashier": { "parameters": [{ "$ref": "#/components/parameters/CommerceId" }], "post": { "summary": "Renew pending WeChat prepay for the authenticated original payer", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Business envelope data: {type:wechatpay,mock,parameters}. Only mock=false may invoke wx.requestPayment; client success never grants credits." } } } }
  }
}
