{
  "openapi": "3.0.3",
  "info": {
    "title": "Course Commerce API",
    "version": "1.0.0",
    "description": "Feature-gated course commerce. Amounts are integer CNY fen. Personal/offline transfers cannot use automatic gateway refunds. Published cash-cancellation policies use immutable order snapshots and confirmed server quotes; legacy credits retain their existing cancellation rules. Live charging requires separate merchant acceptance."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  },
  "paths": {
    "/v1/student/commerce/catalog": {
      "get": {
        "tags": [
          "Commerce"
        ],
        "summary": "Published fixed-price course offers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Business envelope: code=10000 success; code=400/403/404/500 failure, data plus human-readable message"
          }
        }
      }
    },
    "/v1/student/commerce/orders": {
      "get": {
        "tags": [
          "Commerce"
        ],
        "summary": "Current student orders",
        "security": [
