          "Commerce"
        ],
        "summary": "Create or replay checkout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Business envelope: code=10000 success; code=400/403/404/500 failure, data plus human-readable message"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "offerId",
                  "key"
                ],
                "properties": {
                  "offerId": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
