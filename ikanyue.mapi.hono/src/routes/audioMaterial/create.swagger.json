{
  "openapi": "3.0.0",
  "info": {
    "title": "创建音频材料",
    "version": "1.0.0",
    "description": "创建新的音频材料记录，支持设置标题、类型、描述、音频源、内容等完整信息，需要教师权限"
  },
  "paths": {
    "/v1/audioMaterial/create": {
      "post": {
        "summary": "创建音频材料",
        "description": "创建新的音频材料记录，支持完整的音频材料信息设置",
        "tags": ["AudioMaterial"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "description": "音频材料创建数据",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "audioSource"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "音频材料标题",
                    "example": "英语听力练习1"
                  },
                  "audioSource": {
                    "type": "string",
                    "description": "音频源文件",
                    "example": "audio_file.mp3"
                  },
                  "type": {
                    "type": "string",
                    "description": "音频类型",
                    "example": "listening"
                  },
                  "description": {
                    "type": "string",
                    "description": "音频描述",
                    "example": "基础英语听力材料"
                  },
                  "content": {
                    "type": "string",
                    "description": "音频内容",
                    "example": "详细的音频内容"
                  },
                  "publishedAt": {
                    "type": "string",
                    "format": "date",
                    "description": "发布时间",
                    "example": "2024-01-01"
                  },
                  "author": {
                    "type": "string",
                    "description": "作者",
                    "example": "张老师"
                  },
                  "duration": {
                    "type": "number",
                    "description": "音频时长（秒）",
                    "minimum": 0,
                    "example": 180
                  },
                  "sequence": {
                    "type": "number",
                    "description": "排序序号",
                    "minimum": 0,
                    "example": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": ["draft", "published"],
                    "description": "状态",
                    "default": "draft",
                    "example": "draft"
                  },
                  "coverImage": {
                    "type": "string",
                    "description": "封面图片文件",
                    "example": "cover.jpg"
                  },
                  "language": {
                    "type": "string",
                    "enum": ["中文", "英文"],
                    "description": "语言",
                    "example": "中文"
                  },
                  "difficulty": {
                    "type": "number",
                    "description": "难度等级（1-5）",
                    "minimum": 1,
                    "maximum": 5,
                    "example": 3
                  },
                  "tags": {
                    "type": "string",
                    "description": "标签",
                    "example": "听力,初级"
                  }
                }
              },
              "example": {
                "title": "英语听力练习1",
                "audioSource": "audio_file.mp3",
                "type": "listening",
                "description": "基础英语听力材料",
                "content": "详细的音频内容",
                "publishedAt": "2024-01-01",
                "author": "张老师",
                "duration": 180,
                "sequence": 1,
                "status": "draft",
                "coverImage": "cover.jpg",
                "language": "中文",
                "difficulty": 3,
                "tags": "听力,初级"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "音频材料创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 10000
                    },
                    "message": {
                      "type": "string",
                      "example": "音频材料创建成功"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "音频材料ID"
                        },
                        "title": {
                          "type": "string",
                          "description": "音频材料标题"
                        },
                        "type": {
                          "type": "string",
                          "description": "音频类型"
                        },
                        "description": {
                          "type": "string",
                          "description": "音频描述"
                        },
                        "audioSource": {
                          "type": "string",
                          "description": "音频源文件"
                        },
                        "content": {
                          "type": "string",
                          "description": "音频内容"
                        },
                        "publishedAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "发布时间"
                        },
                        "author": {
                          "type": "string",
                          "description": "作者"
                        },
                        "duration": {
                          "type": "number",
                          "description": "音频时长（秒）"
                        },
                        "sequence": {
                          "type": "number",
                          "description": "排序序号"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["draft", "published"],
                          "description": "状态"
                        },
                        "language": {
                          "type": "string",
                          "enum": ["中文", "英文"],
                          "description": "语言"
                        },
                        "difficulty": {
                          "type": "number",
                          "description": "难度等级"
                        },
                        "tags": {
                          "type": "string",
                          "description": "标签"
                        },
                        "coverImage": {
                          "type": "string",
                          "description": "封面图片文件"
                        },
                        "created": {
                          "type": "string",
                          "format": "date-time",
                          "description": "创建时间"
                        },
                        "updated": {
                          "type": "string",
                          "format": "date-time",
                          "description": "更新时间"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 10000,
                  "message": "音频材料创建成功",
                  "data": {
                    "id": "a7c3q8yq1wksd3z",
                    "title": "英语听力练习1",
                    "type": "listening",
                    "description": "基础英语听力材料",
                    "audioSource": "audio_file.mp3",
                    "content": "详细的音频内容",
                    "publishedAt": "2024-01-01T00:00:00.000Z",
                    "author": "张老师",
                    "duration": 180,
                    "sequence": 1,
                    "status": "draft",
                    "coverImage": "cover.jpg",
                    "language": "中文",
                    "difficulty": 3,
                    "tags": "听力,初级",
                    "created": "2024-12-26T10:00:00.000Z",
                    "updated": "2024-12-26T10:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40001
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                },
                "examples": {
                  "titleEmpty": {
                    "summary": "标题为空",
                    "value": {
                      "code": 40001,
                      "message": "音频材料标题不能为空",
                      "data": null
                    }
                  },
                  "audioSourceEmpty": {
                    "summary": "音频源为空",
                    "value": {
                      "code": 40001,
                      "message": "音频源文件不能为空",
                      "data": null
                    }
                  },
                  "difficultyInvalid": {
                    "summary": "难度等级错误",
                    "value": {
                      "code": 40001,
                      "message": "难度等级必须为1-5之间的整数",
                      "data": null
                    }
                  },
                  "languageInvalid": {
                    "summary": "语言选项错误",
                    "value": {
                      "code": 40001,
                      "message": "语言只能是'中文'或'英文'",
                      "data": null
                    }
                  },
                  "statusInvalid": {
                    "summary": "状态选项错误",
                    "value": {
                      "code": 40001,
                      "message": "状态只能是'draft'或'published'",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40101
                    },
                    "message": {
                      "type": "string",
                      "example": "认证失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40301
                    },
                    "message": {
                      "type": "string",
                      "example": "需要教师权限"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 50001
                    },
                    "message": {
                      "type": "string",
                      "example": "创建音频材料失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
} 