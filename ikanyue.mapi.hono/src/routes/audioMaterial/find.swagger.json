{
  "openapi": "3.0.0",
  "info": {
    "title": "查询音频材料",
    "version": "1.0.0",
    "description": "分页查询音频材料列表或获取单个音频材料详情，支持多种过滤条件，包括标题搜索、类型过滤、状态过滤等"
  },
  "paths": {
    "/v1/audioMaterial/find": {
      "post": {
        "summary": "查询音频材料",
        "description": "支持单个查询和分页列表查询，包含多种筛选条件",
        "tags": ["AudioMaterial"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "description": "查询条件",
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "音频材料ID（用于单个查询）",
                    "example": "a7c3q8yq1wksd3z"
                  },
                  "page": {
                    "type": "integer",
                    "description": "页码",
                    "minimum": 1,
                    "default": 1,
                    "example": 1
                  },
                  "limit": {
                    "type": "integer",
                    "description": "每页数量",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 20,
                    "example": 10
                  },
                  "title": {
                    "type": "string",
                    "description": "标题搜索（模糊匹配）",
                    "example": "英语听力"
                  },
                  "type": {
                    "type": "string",
                    "description": "类型过滤",
                    "example": "listening"
                  },
                  "author": {
                    "type": "string",
                    "description": "作者搜索（模糊匹配）",
                    "example": "张老师"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["published", "draft", "all"],
                    "description": "状态过滤",
                    "default": "published",
                    "example": "published"
                  },
                  "language": {
                    "type": "string",
                    "enum": ["中文", "英文"],
                    "description": "语言过滤",
                    "example": "中文"
                  },
                  "difficulty": {
                    "type": "string",
                    "description": "难度过滤（1-5）",
                    "example": "3"
                  },
                  "tags": {
                    "type": "string",
                    "description": "标签搜索（模糊匹配）",
                    "example": "初级"
                  },
                  "sort": {
                    "type": "string",
                    "description": "排序方式（字段名前加'-'表示倒序）",
                    "default": "-created",
                    "example": "title"
                  }
                }
              },
              "example": {
                "page": 1,
                "limit": 10,
                "title": "英语听力",
                "status": "published",
                "language": "中文",
                "sort": "-created"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 10000
                    },
                    "message": {
                      "type": "string",
                      "example": "查询成功"
                    },
                    "data": {
                      "oneOf": [
                        {
                          "type": "object",
                          "description": "单个音频材料（当提供id时）",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "audioSource": {
                              "type": "string"
                            },
                            "content": {
                              "type": "string"
                            },
                            "publishedAt": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "author": {
                              "type": "string"
                            },
                            "duration": {
                              "type": "number"
                            },
                            "sequence": {
                              "type": "number"
                            },
                            "status": {
                              "type": "string",
                              "enum": ["draft", "published"]
                            },
                            "language": {
                              "type": "string",
                              "enum": ["中文", "英文"]
                            },
                            "difficulty": {
                              "type": "number"
                            },
                            "tags": {
                              "type": "string"
                            },
                            "coverImage": {
                              "type": "string"
                            },
                            "created": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "updated": {
                              "type": "string",
                              "format": "date-time"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "description": "音频材料列表（分页查询）",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "type": {
                                    "type": "string"
                                  },
                                  "description": {
                                    "type": "string"
                                  },
                                  "audioSource": {
                                    "type": "string"
                                  },
                                  "duration": {
                                    "type": "number"
                                  },
                                  "status": {
                                    "type": "string"
                                  },
                                  "language": {
                                    "type": "string"
                                  },
                                  "difficulty": {
                                    "type": "number"
                                  },
                                  "coverImage": {
                                    "type": "string"
                                  },
                                  "created": {
                                    "type": "string",
                                    "format": "date-time"
                                  }
                                }
                              }
                            },
                            "totalItems": {
                              "type": "integer",
                              "description": "总记录数"
                            },
                            "totalPages": {
                              "type": "integer",
                              "description": "总页数"
                            },
                            "page": {
                              "type": "integer",
                              "description": "当前页码"
                            },
                            "perPage": {
                              "type": "integer",
                              "description": "每页数量"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "examples": {
                  "singleRecord": {
                    "summary": "单个音频材料查询",
                    "value": {
                      "code": 10000,
                      "message": "查询成功",
                      "data": {
                        "id": "a7c3q8yq1wksd3z",
                        "title": "英语听力练习1",
                        "type": "listening",
                        "description": "基础英语听力材料",
                        "audioSource": "audio_file.mp3",
                        "content": "音频内容描述",
                        "publishedAt": "2024-01-01T00:00:00.000Z",
                        "author": "张老师",
                        "duration": 180,
                        "sequence": 1,
                        "status": "published",
                        "coverImage": "cover.jpg",
                        "language": "中文",
                        "difficulty": 3,
                        "tags": "听力,初级",
                        "created": "2024-12-26T10:00:00.000Z",
                        "updated": "2024-12-26T10:00:00.000Z"
                      }
                    }
                  },
                  "listRecords": {
                    "summary": "音频材料列表查询",
                    "value": {
                      "code": 10000,
                      "message": "查询成功",
                      "data": {
                        "items": [
                          {
                            "id": "a7c3q8yq1wksd3z",
                            "title": "英语听力练习1",
                            "type": "listening",
                            "description": "基础英语听力材料",
                            "audioSource": "audio_file.mp3",
                            "coverImage": "cover.jpg",
                            "duration": 180,
                            "status": "published",
                            "language": "中文",
                            "difficulty": 3,
                            "created": "2024-12-26T10:00:00.000Z"
                          }
                        ],
                        "totalItems": 25,
                        "totalPages": 3,
                        "page": 1,
                        "perPage": 10
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40001
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                },
                "examples": {
                  "invalidPage": {
                    "summary": "页码参数错误",
                    "value": {
                      "code": 40001,
                      "message": "页码和每页数量必须为正整数",
                      "data": null
                    }
                  },
                  "limitExceeded": {
                    "summary": "每页数量超限",
                    "value": {
                      "code": 40001,
                      "message": "每页数量不能超过100",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40101
                    },
                    "message": {
                      "type": "string",
                      "example": "认证失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "音频材料不存在",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40401
                    },
                    "message": {
                      "type": "string",
                      "example": "音频材料不存在"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 50001
                    },
                    "message": {
                      "type": "string",
                      "example": "查询音频材料失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
} 