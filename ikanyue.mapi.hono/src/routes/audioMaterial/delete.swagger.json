{
  "openapi": "3.0.0",
  "info": {
    "title": "删除音频材料",
    "version": "1.0.0",
    "description": "删除音频材料接口，处理audioMaterial的delete操作相关的业务逻辑和数据操作"
  },
  "paths": {
    "/v1/audioMaterial/delete": {
      "post": {
        "summary": "删除音频材料",
        "description": "根据ID删除指定的音频材料记录",
        "tags": ["AudioMaterial"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "description": "删除操作所需的音频材料ID",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "要删除的音频材料ID",
                    "example": "a7c3q8yq1wksd3z"
                  }
                }
              },
              "example": {
                "id": "a7c3q8yq1wksd3z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "音频材料删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 10000
                    },
                    "message": {
                      "type": "string",
                      "example": "音频材料删除成功"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "被删除的音频材料ID"
                        },
                        "deleted": {
                          "type": "boolean",
                          "description": "删除状态",
                          "example": true
                        },
                        "deletedAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "删除时间"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 10000,
                  "message": "音频材料删除成功",
                  "data": {
                    "id": "a7c3q8yq1wksd3z",
                    "deleted": true,
                    "deletedAt": "2024-12-26T10:30:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40001
                    },
                    "message": {
                      "type": "string",
                      "example": "音频材料ID不能为空"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40101
                    },
                    "message": {
                      "type": "string",
                      "example": "认证失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40301
                    },
                    "message": {
                      "type": "string",
                      "example": "需要教师权限"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "音频材料不存在",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 40401
                    },
                    "message": {
                      "type": "string",
                      "example": "音频材料不存在"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 50001
                    },
                    "message": {
                      "type": "string",
                      "example": "删除音频材料失败"
                    },
                    "data": {
                      "type": "null",
                      "example": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
} 