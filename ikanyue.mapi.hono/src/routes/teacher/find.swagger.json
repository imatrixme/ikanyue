{
  "openapi": "3.0.0",
  "info": {
    "title": "教师查询接口",
    "version": "1.0.0",
    "description": "分页查询教师列表，支持按手机号、昵称和审核状态进行筛选，用于管理员管理教师账户。提供完整的分页功能和审核状态管理。"
  },
  "paths": {
    "/v1/teacher/find": {
      "get": {
        "summary": "查询教师列表",
        "description": "分页查询教师信息，支持手机号、昵称和审核状态的模糊搜索。需要管理员权限，自动过滤敏感字段。",
        "tags": ["Teacher"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "页码，从1开始",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页数量，最大100",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 20
            }
          },
          {
            "name": "cellphone",
            "in": "query",
            "description": "手机号模糊搜索",
            "required": false,
            "schema": {
              "type": "string",
              "example": "139"
            }
          },
          {
            "name": "nickName",
            "in": "query",
            "description": "昵称模糊搜索",
            "required": false,
            "schema": {
              "type": "string",
              "example": "张老师"
            }
          },
          {
            "name": "verified",
            "in": "query",
            "description": "审核状态过滤",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherListResponse"
                },
                "example": {
                  "code": 10000,
                  "message": "查询成功",
                  "data": {
                    "items": [
                      {
                        "id": "teacher_67894a2b-f8c7-4b2a-9d1e-3456789abcde",
                        "sn": "sn_unique_id_12345",
                        "cellphone": "13900139000",
                        "nickName": "张老师",
                        "avatar": "https://example.com/avatar.jpg",
                        "realname": "张三丰",
                        "gender": "1",
                        "age": 35,
                        "province": "广东省",
                        "city": "深圳市",
                        "address": "南山区科技园",
                        "blocked": false,
                        "verified": true,
                        "idAdmin": false,
                        "qualification": "高级教师资格证",
                        "experience": 10,
                        "bio": "资深数学教师，擅长初高中数学教学",
                        "lastLoginAt": "2024-12-26 10:00:00.000Z",
                        "created": "2024-12-26 09:00:00.000Z",
                        "updated": "2024-12-26 10:00:00.000Z"
                      },
                      {
                        "id": "teacher_67894a2b-f8c7-4b2a-9d1e-3456789abcdf",
                        "sn": "sn_unique_id_12346",
                        "cellphone": "13900139001",
                        "nickName": "李老师",
                        "avatar": "https://example.com/avatar2.jpg",
                        "realname": "李四光",
                        "gender": "1",
                        "age": 28,
                        "province": "广东省",
                        "city": "广州市",
                        "address": "天河区珠江新城",
                        "blocked": false,
                        "verified": false,
                        "idAdmin": false,
                        "qualification": "中级教师资格证",
                        "experience": 5,
                        "bio": "年轻有为的英语教师",
                        "lastLoginAt": null,
                        "created": "2024-12-26 08:30:00.000Z",
                        "updated": "2024-12-26 08:30:00.000Z"
                      }
                    ],
                    "totalItems": 30,
                    "totalPages": 3,
                    "page": 1,
                    "perPage": 10
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidParams": {
                    "summary": "参数格式错误",
                    "value": {
                      "code": 400,
                      "message": "页码和每页数量必须为正整数",
                      "data": null
                    }
                  },
                  "limitExceeded": {
                    "summary": "数量超限",
                    "value": {
                      "code": 400,
                      "message": "每页数量不能超过100",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "认证失败",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "权限不足，需要管理员权限",
                  "data": null
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "queryFailed": {
                    "summary": "查询失败",
                    "value": {
                      "code": 500,
                      "message": "查询失败，请稍后重试",
                      "data": null
                    }
                  },
                  "serverError": {
                    "summary": "系统异常",
                    "value": {
                      "code": 500,
                      "message": "服务器内部错误",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TeacherItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "教师 ID",
            "example": "teacher_67894a2b-f8c7-4b2a-9d1e-3456789abcde"
          },
          "sn": {
            "type": "string",
            "description": "教师序列号",
            "example": "sn_unique_id_12345"
          },
          "cellphone": {
            "type": "string",
            "description": "手机号",
            "example": "13900139000"
          },
          "nickName": {
            "type": "string",
            "description": "昵称",
            "example": "张老师"
          },
          "avatar": {
            "type": "string",
            "description": "头像 URL",
            "example": "https://example.com/avatar.jpg"
          },
          "realname": {
            "type": "string",
            "description": "真实姓名",
            "example": "张三丰"
          },
          "gender": {
            "type": "string",
            "description": "性别 (0:未知，1:男，2:女)",
            "enum": ["0", "1", "2"],
            "example": "1"
          },
          "age": {
            "type": "integer",
            "description": "年龄",
            "example": 35
          },
          "province": {
            "type": "string",
            "description": "省份",
            "example": "广东省"
          },
          "city": {
            "type": "string",
            "description": "城市",
            "example": "深圳市"
          },
          "address": {
            "type": "string",
            "description": "地址",
            "example": "南山区科技园"
          },
          "blocked": {
            "type": "boolean",
            "description": "是否被封禁",
            "example": false
          },
          "verified": {
            "type": "boolean",
            "description": "是否已审核",
            "example": true
          },
          "idAdmin": {
            "type": "boolean",
            "description": "是否为管理员",
            "example": false
          },
          "qualification": {
            "type": "string",
            "description": "教师资格",
            "example": "高级教师资格证"
          },
          "experience": {
            "type": "number",
            "description": "教学经验（年）",
            "example": 10
          },
          "bio": {
            "type": "string",
            "description": "个人简介",
            "example": "资深数学教师，擅长初高中数学教学"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "最后登录时间",
            "example": "2024-12-26 10:00:00.000Z"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间",
            "example": "2024-12-26 09:00:00.000Z"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "description": "更新时间",
            "example": "2024-12-26 10:00:00.000Z"
          }
        }
      },
      "TeacherListData": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeacherItem"
            },
            "description": "教师列表"
          },
          "totalItems": {
            "type": "integer",
            "description": "总记录数",
            "example": 30
          },
          "totalPages": {
            "type": "integer",
            "description": "总页数",
            "example": 3
          },
          "page": {
            "type": "integer",
            "description": "当前页码",
            "example": 1
          },
          "perPage": {
            "type": "integer",
            "description": "每页数量",
            "example": 10
          }
        }
      },
      "TeacherListResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "example": "查询成功"
          },
          "data": {
            "$ref": "#/components/schemas/TeacherListData"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "null",
            "example": null
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "需要管理员权限的 JWT Token"
      }
    }
  },
  "tags": [
    {
      "name": "Teacher",
      "description": "教师管理相关接口"
    }
  ]
} 