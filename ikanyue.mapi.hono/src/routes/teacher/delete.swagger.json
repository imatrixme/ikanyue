{
  "openapi": "3.0.0",
  "info": {
    "title": "删除教师信息",
    "version": "1.0.0",
    "description": "删除教师信息接口，提供安全的教师记录删除功能。会先验证记录存在性，然后执行删除操作。"
  },
  "paths": {
    "/v1/teacher/delete": {
      "post": {
        "summary": "删除教师信息",
        "description": "根据教师ID删除指定的教师记录。会先检查记录是否存在，确保删除操作的安全性。",
        "tags": ["Teacher"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteTeacherRequest"
              },
              "example": {
                "id": "teacher_67894a2b-f8c7-4b2a-9d1e-3456789abcde"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteTeacherResponse"
                },
                "example": {
                  "code": 10000,
                  "message": null,
                  "data": {
                    "success": true,
                    "message": "教师已成功删除"
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "message": "缺少教师ID",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "认证失败",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "教师不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 404,
                  "message": "教师不存在",
                  "data": null
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "deleteFailed": {
                    "summary": "删除失败",
                    "value": {
                      "code": 500,
                      "message": "删除教师失败",
                      "data": null
                    }
                  },
                  "serverError": {
                    "summary": "系统异常",
                    "value": {
                      "code": 500,
                      "message": "服务器内部错误",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeleteTeacherRequest": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "教师记录ID",
            "example": "teacher_67894a2b-f8c7-4b2a-9d1e-3456789abcde"
          }
        }
      },
      "DeleteTeacherData": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "删除是否成功",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "删除结果消息",
            "example": "教师已成功删除"
          }
        }
      },
      "DeleteTeacherResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "data": {
            "$ref": "#/components/schemas/DeleteTeacherData"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "null",
            "example": null
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "需要认证的 JWT Token"
      }
    }
  },
  "tags": [
    {
      "name": "Teacher",
      "description": "教师管理相关接口"
    }
  ]
} 