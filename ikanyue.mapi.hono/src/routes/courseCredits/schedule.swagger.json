{
  "tags": [
    { "name": "Course Calendar", "description": "Role-aware formal lesson schedules" }
  ],
  "paths": {
    "/ops/course-calendar": {
      "get": {
        "tags": ["Course Calendar"],
        "summary": "Query the role-scoped operations course calendar",
        "description": "Academic operators receive the institution calendar. Teacher-only operators receive only lessons assigned to the authenticated teacher.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "from", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "teacherId", "in": "query", "schema": { "type": "string" } },
          { "name": "studentId", "in": "query", "schema": { "type": "string" } },
          { "name": "classId", "in": "query", "schema": { "type": "string" } },
          { "name": "courseSpecId", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "originType", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Role-scoped operations calendar projection" } }
      }
    },
    "/v1/teacher/schedule": {
      "get": {
        "tags": ["Course Calendar"],
        "summary": "Query the authenticated teacher schedule",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "from", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "includeAvailability", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "Teacher schedule projection" } }
      }
    },
    "/v1/schedule/upcoming": {
      "get": {
        "tags": ["Course Calendar"],
        "summary": "Return up to three upcoming formal lessons for the active role",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 3, "default": 3 } }
        ],
        "responses": { "200": { "description": "Role-safe upcoming lesson projection" } }
      }
    }
  }
}
