{
  "openapi": "3.0.0",
  "info": { "title": "学员课程点接口", "version": "2.0.0" },
  "paths": {
    "/v1/course-credits/summary": {
      "get": {
        "summary": "查询本人课程点汇总",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/v1/course-credits/batches": {
      "get": {
        "summary": "分页查询本人课程点批次",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "creditTypeId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/v1/course-credits/batches/{batchId}": {
      "get": {
        "summary": "查询本人课程点批次详情",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "batchId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/v1/course-credits/events": {
      "get": {
        "summary": "分页查询本人课程点事件",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "eventType", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/v1/course-credits/conversion-rules": {
      "get": {
        "summary": "查询当前有效兑换规则",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/v1/course-credits/conversions/preview": {
      "post": {
        "summary": "预览本人课程点兑换",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversionRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/v1/course-credits/conversions": {
      "post": {
        "summary": "提交本人课程点兑换",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "X-Trace-Id", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversionRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/v1/course-credits/conversion-authorizations": {
      "post": {
        "summary": "基于当前预览授权本人自动兑换",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversionAuthorizationRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/v1/course-credits/sessions": {
      "get": {
        "summary": "分页查询本人课堂课程点状态",
        "tags": ["CourseCredits"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }],
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
      "PerPage": { "name": "perPage", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
    },
    "responses": {
      "CourseCreditResponse": {
        "description": "成功结果或稳定业务错误",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CourseCreditResponse" } } }
      }
    },
    "schemas": {
      "ConversionRequest": {
        "type": "object",
        "required": ["ruleId", "sourceQuantity"],
        "properties": {
          "ruleId": { "type": "string" },
          "sourceQuantity": { "type": "integer", "minimum": 1 },
          "previewAt": { "type": "string", "format": "date-time" },
          "previewHash": { "type": "string" },
          "authorizationId": { "type": "string" },
          "targetTermEnd": { "type": "string", "format": "date-time" }
        }
      },
      "ConversionAuthorizationRequest": {
        "allOf": [
          { "$ref": "#/components/schemas/ConversionRequest" },
          {
            "type": "object",
            "required": ["previewAt", "previewHash"],
            "properties": { "validTo": { "type": "string", "format": "date-time" } }
          }
        ]
      },
      "CourseCreditResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string", "nullable": true },
          "data": { "type": "object", "nullable": true },
          "errorCode": { "type": "string", "nullable": true },
          "details": { "type": "object", "nullable": true },
          "operationId": { "type": "string", "nullable": true },
          "traceId": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
