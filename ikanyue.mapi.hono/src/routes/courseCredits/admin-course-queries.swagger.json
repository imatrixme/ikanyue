{
  "openapi": "3.0.0",
  "info": { "title": "课程运营明细查询", "version": "2.0.0" },
  "paths": {
    "/ops/course-credits/package-grant-lines": { "get": { "$ref": "#/components/x-operations/ListResource" } },
    "/ops/course-credits/package-grant-lines/{id}": { "get": { "$ref": "#/components/x-operations/GetResource" } },
    "/ops/course-credits/enrollments": { "get": { "$ref": "#/components/x-operations/ListResource" } },
    "/ops/course-credits/enrollments/{id}": { "get": { "$ref": "#/components/x-operations/GetResource" } },
    "/ops/course-credits/class-students": { "get": { "$ref": "#/components/x-operations/ListResource" } },
    "/ops/course-credits/class-students/{id}": { "get": { "$ref": "#/components/x-operations/GetResource" } },
    "/ops/course-credits/class-teachers": { "get": { "$ref": "#/components/x-operations/ListResource" } },
    "/ops/course-credits/class-teachers/{id}": { "get": { "$ref": "#/components/x-operations/GetResource" } },
    "/ops/course-credits/session-students": { "get": { "$ref": "#/components/x-operations/ListResource" } },
    "/ops/course-credits/session-students/{id}": { "get": { "$ref": "#/components/x-operations/GetResource" } },
    "/ops/course-credits/session-classes": { "get": { "$ref": "#/components/x-operations/ListResource" } },
    "/ops/course-credits/session-classes/{id}": { "get": { "$ref": "#/components/x-operations/GetResource" } },
    "/ops/course-credits/session-teachers": { "get": { "$ref": "#/components/x-operations/ListResource" } },
    "/ops/course-credits/session-teachers/{id}": { "get": { "$ref": "#/components/x-operations/GetResource" } },
    "/ops/course-credits/audit-logs": { "get": { "$ref": "#/components/x-operations/ListResource" } },
    "/ops/course-credits/audit-logs/{id}": { "get": { "$ref": "#/components/x-operations/GetResource" } }
  },
  "components": {
    "x-operations": {
      "ListResource": {
        "summary": "分页查询课程运营明细",
        "tags": ["CourseOperations"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "perPage", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
          { "name": "studentId", "in": "query", "schema": { "type": "string" } },
          { "name": "teacherId", "in": "query", "schema": { "type": "string" } },
          { "name": "classId", "in": "query", "schema": { "type": "string" } },
          { "name": "sessionId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "分页结果" } }
      },
      "GetResource": {
        "summary": "查询课程运营明细",
        "tags": ["CourseOperations"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "详情结果" } }
      }
    }
  }
}
