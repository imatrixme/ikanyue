{
  "openapi": "3.0.0",
  "info": { "title": "课程点历史迁移", "version": "2.0.0" },
  "paths": {
    "/ops/course-credits/migration/inventory": {
      "get": {
        "summary": "盘点历史课时与学习数据",
        "tags": ["CourseCreditOps"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/ops/course-credits/migration/preview": {
      "post": {
        "summary": "预览人工映射迁移计划与差异",
        "tags": ["CourseCreditOps"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    },
    "/ops/course-credits/migration/apply": {
      "post": {
        "summary": "提交零差异历史迁移计划",
        "tags": ["CourseCreditOps"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "X-Trace-Id", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["plan", "previewHash"] } } } },
        "responses": { "200": { "$ref": "#/components/responses/CourseCreditResponse" } }
      }
    }
  }
}
