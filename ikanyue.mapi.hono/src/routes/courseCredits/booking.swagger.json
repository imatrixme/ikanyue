{
  "openapi": "3.0.0",
  "info": { "title": "课程预约接口", "version": "2.1.0" },
  "paths": {
    "/ops/course-bookings/students/{studentId}/options": {
      "get": { "summary": "教务查看学员可预约的课程与教师", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "name": "studentId", "in": "path", "required": true, "description": "学员编号", "schema": { "type": "string" } }, { "name": "courseId", "in": "query", "required": false, "description": "只看某门课程", "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/students/{studentId}/slots": {
      "get": { "summary": "教务查看学员在某个预约课程下的可选时段", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "name": "studentId", "in": "path", "required": true, "description": "学员编号", "schema": { "type": "string" } }, { "name": "offeringId", "in": "query", "required": true, "description": "预约课程编号", "schema": { "type": "string" } }, { "name": "from", "in": "query", "required": false, "description": "起始时间", "schema": { "type": "string" } }, { "name": "to", "in": "query", "required": false, "description": "结束时间", "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/student/appointments/{appointmentId}/cancellation-preview": {
      "get": { "summary": "预览本人预约取消扣费及退款", "tags": ["StudentBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }], "responses": { "200": { "description": "data contains mode=credit|cash, amount, fee, quantity and cash policyVersion/receivedAt. Cash cancellation must echo expectedRefundAmount and expectedFee. This route does not require the commerce feature flag." } } }
    },
    "/v1/student/booking-options": {
      "get": { "summary": "查询本人可预约课程与教师", "tags": ["StudentBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/StudentCourseIdQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/student/booking-slots": {
      "get": { "summary": "查询教师可预约时段", "tags": ["StudentBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OfferingIdQueryRequired" }, { "$ref": "#/components/parameters/FromQuery" }, { "$ref": "#/components/parameters/ToQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/student/appointments": {
      "get": { "summary": "分页查询本人预约", "tags": ["StudentBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/StatusQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } },
      "post": { "summary": "发起课程预约", "tags": ["StudentBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/AppointmentRequest" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/student/appointments/{appointmentId}": {
      "get": { "summary": "查询本人预约详情", "tags": ["StudentBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/student/appointments/{appointmentId}/withdraw": {
      "post": { "summary": "撤回待确认预约", "tags": ["StudentBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/student/appointments/{appointmentId}/cancel": {
      "post": { "summary": "取消已确认预约", "tags": ["StudentBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/booking/dashboard": {
      "get": { "summary": "查询教师预约工作台", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/appointments": {
      "get": { "summary": "分页查询教师预约", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/StatusQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/appointments/{appointmentId}": {
      "get": { "summary": "查询教师预约详情", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/calendar": {
      "get": { "summary": "查询教师日历", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/FromQuery" }, { "$ref": "#/components/parameters/ToQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/appointments/{appointmentId}/confirm": {
      "post": { "summary": "确认预约并原子占用时段与课时", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/appointments/{appointmentId}/decline": {
      "post": { "summary": "拒绝待确认预约", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/appointments/{appointmentId}/cancel": {
      "post": { "summary": "教师取消已确认预约", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/appointments/{appointmentId}/reschedule": {
      "post": { "summary": "教师改期并交换日历占位", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reschedule" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/offerings/{offeringId}/availability": {
      "get": { "summary": "查询教师课程可预约时间", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OfferingId" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } },
      "put": { "summary": "替换教师每周可预约时间", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OfferingId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/WeeklyAvailability" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/offerings/{offeringId}/availability-overrides": {
      "post": { "summary": "新增日期级可用或不可用覆盖", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OfferingId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/AvailabilityOverride" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/v1/teacher/availability-overrides/{overrideId}/cancel": {
      "post": { "summary": "撤销日期级可用时间覆盖", "tags": ["TeacherBooking"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OverrideId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/dashboard": {
      "get": { "summary": "查询预约运营看板", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/reference-data": {
      "get": { "summary": "查询预约配置所需教师、课程、课时类型和策略", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/appointments": {
      "get": { "summary": "分页查询全部预约", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/StatusQuery" }, { "$ref": "#/components/parameters/TeacherIdQuery" }, { "$ref": "#/components/parameters/StudentIdQuery" }, { "$ref": "#/components/parameters/CourseSpecIdQuery" }, { "$ref": "#/components/parameters/FromQuery" }, { "$ref": "#/components/parameters/ToQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } },
      "post": { "summary": "教务代学员申请一对一预约，可同时确认", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["studentId", "offeringId", "startAt", "endAt"], "properties": { "studentId": { "type": "string" }, "offeringId": { "type": "string" }, "startAt": { "type": "string", "format": "date-time" }, "endAt": { "type": "string", "format": "date-time" }, "note": { "type": "string", "maxLength": 500 }, "confirm": { "type": "boolean", "description": "为 true 时在同一命令内确认预约（需要预约占课功能开关）" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/appointments/{appointmentId}": {
      "get": { "summary": "查询预约审计详情", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/appointments/{appointmentId}/confirm": {
      "post": { "summary": "教务代教师确认待处理预约", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/appointments/{appointmentId}/decline": {
      "post": { "summary": "教务代教师拒绝待处理预约", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/appointments/{appointmentId}/cancel": {
      "post": { "summary": "教务取消预约", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/appointments/{appointmentId}/reschedule": {
      "post": { "summary": "教务改期预约", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/AppointmentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reschedule" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/policies": {
      "get": { "summary": "分页查询预约策略版本", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/StatusQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } },
      "post": { "summary": "创建预约策略版本", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/BookingPolicy" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/offerings": {
      "get": { "summary": "分页查询教师课程预约配置", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/StatusQuery" }, { "$ref": "#/components/parameters/TeacherIdQuery" }, { "$ref": "#/components/parameters/CourseSpecIdQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } },
      "post": { "summary": "创建教师课程预约配置", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/BookingOffering" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/offerings/{offeringId}": {
      "patch": { "summary": "更新教师课程预约配置", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OfferingId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/BookingOffering" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/offerings/{offeringId}/availability": {
      "put": { "summary": "教务替换教师课程的每周可预约时间", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OfferingId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/WeeklyAvailability" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/offerings/{offeringId}/availability-overrides": {
      "post": { "summary": "教务新增教师课程的日期级开放或停用时间", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OfferingId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/AvailabilityOverride" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/availability-overrides/{overrideId}/cancel": {
      "post": { "summary": "教务撤销教师课程的日期级时间覆盖", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/OverrideId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/availability": {
      "get": { "summary": "查询教师可用时间配置", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/StatusQuery" }, { "$ref": "#/components/parameters/TeacherIdQuery" }, { "$ref": "#/components/parameters/OfferingIdQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/conflicts": {
      "get": { "summary": "分页查询历史排课冲突", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/StatusQuery" }, { "$ref": "#/components/parameters/TeacherIdQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/conflicts/{conflictId}/resolve": {
      "post": { "summary": "关闭历史排课冲突", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConflictId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/ConflictResolution" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/backfill/preview": {
      "get": { "summary": "预览历史未来课程日历占位回填", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/FromQuery" }, { "$ref": "#/components/parameters/ToQuery" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/backfill": {
      "post": { "summary": "执行历史未来课程日历占位回填", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Backfill" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/workers/expire": {
      "post": { "summary": "运行待确认预约过期任务", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-bookings/workers/fulfill": {
      "post": { "summary": "运行已完成课堂预约归档任务", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    },
    "/ops/course-credits/sessions/{sessionId}/cancel": {
      "post": { "summary": "取消普通课堂并释放课时与日历占位", "tags": ["BookingOperations"], "security": [{ "BearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/SessionId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/BookingResponse" } } }
    }
  },
  "components": {
    "parameters": {
      "AppointmentId": { "name": "appointmentId", "in": "path", "required": true, "schema": { "type": "string" } },
      "OfferingId": { "name": "offeringId", "in": "path", "required": true, "schema": { "type": "string" } },
      "OverrideId": { "name": "overrideId", "in": "path", "required": true, "schema": { "type": "string" } },
      "ConflictId": { "name": "conflictId", "in": "path", "required": true, "schema": { "type": "string" } },
      "SessionId": { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
      "PerPage": { "name": "perPage", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
      "StatusQuery": { "name": "status", "in": "query", "schema": { "type": "string" } },
      "FromQuery": { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
      "ToQuery": { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
      "StudentCourseIdQuery": { "name": "courseId", "in": "query", "schema": { "type": "string" } },
      "CourseSpecIdQuery": { "name": "courseSpecId", "in": "query", "schema": { "type": "string" } },
      "TeacherIdQuery": { "name": "teacherId", "in": "query", "schema": { "type": "string" } },
      "StudentIdQuery": { "name": "studentId", "in": "query", "schema": { "type": "string" } },
      "OfferingIdQuery": { "name": "offeringId", "in": "query", "schema": { "type": "string" } },
      "OfferingIdQueryRequired": { "name": "offeringId", "in": "query", "required": true, "schema": { "type": "string" } }
    },
    "requestBodies": {
      "AppointmentRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppointmentRequest" } } } },
      "Reason": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reason" } } } },
      "Reschedule": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reschedule" } } } },
      "WeeklyAvailability": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeeklyAvailability" } } } },
      "AvailabilityOverride": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AvailabilityOverride" } } } },
      "BookingPolicy": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookingPolicy" } } } },
      "BookingOffering": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookingOffering" } } } },
      "ConflictResolution": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConflictResolution" } } } },
      "Backfill": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Backfill" } } } }
    },
    "responses": {
      "BookingResponse": { "description": "预约查询结果、命令结果或稳定业务错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookingResponse" } } } }
    },
    "schemas": {
      "AppointmentRequest": { "type": "object", "required": ["offeringId", "startAt", "endAt"], "properties": { "offeringId": { "type": "string" }, "startAt": { "type": "string", "format": "date-time" }, "endAt": { "type": "string", "format": "date-time" }, "note": { "type": "string", "maxLength": 500 } } },
      "Reason": { "type": "object", "properties": { "reason": { "type": "string", "maxLength": 500 } } },
      "Reschedule": { "type": "object", "required": ["newStartAt", "newEndAt", "reason"], "properties": { "newStartAt": { "type": "string", "format": "date-time" }, "newEndAt": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "maxLength": 500 } } },
      "AvailabilityWindow": { "type": "object", "required": ["weekday", "startMinute", "endMinute"], "properties": { "weekday": { "type": "integer", "minimum": 1, "maximum": 7 }, "startMinute": { "type": "integer", "minimum": 0, "maximum": 1439 }, "endMinute": { "type": "integer", "minimum": 1, "maximum": 1440 } } },
      "InstitutionWindow": { "type": "object", "required": ["startMinute", "endMinute"], "properties": { "startMinute": { "type": "integer", "minimum": 0, "maximum": 1439 }, "endMinute": { "type": "integer", "minimum": 1, "maximum": 1440 } } },
      "WeeklyAvailability": { "type": "object", "required": ["rules"], "properties": { "mode": { "type": "string", "enum": ["default", "custom"] }, "rules": { "type": "array", "items": { "$ref": "#/components/schemas/AvailabilityWindow" } } } },
      "AvailabilityOverride": { "type": "object", "required": ["type", "startAt", "endAt"], "properties": { "type": { "type": "string", "enum": ["available", "unavailable"] }, "startAt": { "type": "string", "format": "date-time" }, "endAt": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "maxLength": 500 } } },
      "BookingPolicy": { "type": "object", "required": ["code", "name", "status", "effectiveFrom"], "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "timezone": { "type": "string", "default": "Asia/Shanghai" }, "defaultWindows": { "type": "array", "items": { "$ref": "#/components/schemas/InstitutionWindow" } }, "status": { "type": "string", "enum": ["draft", "active", "inactive"] }, "effectiveFrom": { "type": "string", "format": "date-time" }, "effectiveTo": { "type": "string", "format": "date-time" }, "slotStepMinutes": { "type": "integer", "minimum": 1 }, "claimGranularityMinutes": { "type": "integer", "minimum": 1 }, "minLeadMinutes": { "type": "integer", "minimum": 0 }, "maxAdvanceDays": { "type": "integer", "minimum": 1 }, "responseTtlMinutes": { "type": "integer", "minimum": 1 }, "responseCutoffMinutes": { "type": "integer", "minimum": 0 }, "cancellationCutoffMinutes": { "type": "integer", "minimum": 0 } } },
      "BookingOffering": { "type": "object", "required": ["teacherId", "courseSpecId", "creditTypeId", "policyId", "status"], "properties": { "teacherId": { "type": "string" }, "courseSpecId": { "type": "string" }, "creditTypeId": { "type": "string" }, "policyId": { "type": "string" }, "location": { "type": "string", "maxLength": 160 }, "status": { "type": "string", "enum": ["draft", "active", "inactive"] } } },
      "ConflictResolution": { "type": "object", "required": ["resolution"], "properties": { "resolution": { "type": "string", "minLength": 4, "maxLength": 500 } } },
      "Backfill": { "type": "object", "required": ["from"], "properties": { "from": { "type": "string", "format": "date-time" }, "to": { "type": "string", "format": "date-time" } } },
      "BookingResponse": { "type": "object", "properties": { "code": { "type": "integer" }, "message": { "type": "string", "nullable": true }, "data": { "nullable": true }, "errorCode": { "type": "string", "nullable": true }, "details": { "type": "object", "nullable": true }, "operationId": { "type": "string", "nullable": true }, "traceId": { "type": "string", "nullable": true } } }
    }
  }
}
