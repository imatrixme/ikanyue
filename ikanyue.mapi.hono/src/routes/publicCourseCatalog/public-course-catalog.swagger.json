{
  "openapi": "3.0.0",
  "info": { "title": "公开课程目录", "version": "2.0.0" },
  "paths": {
    "/v1/public/course-catalog": {
      "get": {
        "summary": "查询已发布课程与课包",
        "tags": ["PublicCourseCatalog"],
        "security": [],
        "responses": { "200": { "$ref": "#/components/responses/PublicCatalogResponse" } }
      }
    },
    "/v1/public/course-catalog/courses/{code}": {
      "get": {
        "summary": "查询公开课程详情",
        "tags": ["PublicCourseCatalog"],
        "security": [],
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "$ref": "#/components/responses/PublicCatalogResponse" } }
      }
    },
    "/v1/public/course-catalog/packages/{code}": {
      "get": {
        "summary": "查询公开课包详情",
        "tags": ["PublicCourseCatalog"],
        "security": [],
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "$ref": "#/components/responses/PublicCatalogResponse" } }
      }
    }
  },
  "components": {
    "responses": {
      "PublicCatalogResponse": {
        "description": "公开课程投影或稳定错误",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicCatalogEnvelope" } } }
      }
    },
    "schemas": {
      "PublicCatalogEnvelope": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string", "nullable": true },
          "data": { "type": "object", "nullable": true },
          "errorCode": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
