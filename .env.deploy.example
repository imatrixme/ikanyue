# Copy to .env.deploy before importing compose.yaml into 1Panel.
# 1Panel builds the server/hono/admin images from the subproject directories.
# HONO_PORT serves the business API and POCKETBASE_PORT the data domain; both reach kanyue.server.
# Before starting a new release: back up PB_DATA_SOURCE, then run
#   docker compose run --rm --entrypoint kanyue-server server migrate up --dir=/pb_data
# OpenResty should reverse proxy the public domain to ADMIN_PORT.

ADMIN_PORT=8080
HONO_PORT=1337
POCKETBASE_PORT=8090
BIND_ADDR=127.0.0.1
PB_DATA_SOURCE=/root/services/dockers/pb_data.ikanyue/pb_data

VITE_OPS_API_BASE=/ops
VITE_OPS_API_MOCK=false

PB_EMAIL=admin@example.com
PB_PASSWORD=change-me

# Required. Generate with: openssl rand -hex 32. Changing it signs every user out.
JWT_SECRET=

# Comma-separated kanyue.server modules handed back to Hono (venues, catalog, identity, students, course-catalog, ledger); empty serves them in Go.
KANYUE_HONO_MODULES=

OPS_REGISTRATION_ENABLED=false
OPS_BOOTSTRAP_CORE_COLLECTIONS=false
OPS_BOOTSTRAP_ADMIN_ENABLED=false

PB_PUBLIC_URL=https://data.ikanyue.com
PUBLIC_ASSET_BASE_URL=https://kyoss.abcmem.com/ikanyue-mp
DEFAULT_AVATAR=

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_JSCODE2SESSION=https://api.weixin.qq.com/sns/jscode2session

# Release stages are enabled independently after migration and shadow checks.
COURSE_CREDIT_GRANTS_ENABLED=false
COURSE_CREDIT_RESERVATION_ENABLED=false
COURSE_CREDIT_SETTLEMENT_ENABLED=false
COURSE_CREDIT_EXPLICIT_CONVERSION_ENABLED=false
COURSE_CREDIT_IMPLICIT_CONVERSION_ENABLED=false
COURSE_CREDIT_MIGRATION_ENABLED=false

# Required only when Outbox delivery is enabled by the external worker.
COURSE_CREDIT_OUTBOX_WEBHOOK_URL=
COURSE_CREDIT_OUTBOX_WEBHOOK_SECRET=
