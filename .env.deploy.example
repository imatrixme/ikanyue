# Copy to .env.deploy before importing compose.yaml into 1Panel.
# 1Panel builds the admin/hono images from the submodule directories.
# OpenResty should reverse proxy the public domain to ADMIN_PORT.

ADMIN_PORT=8080
HONO_PORT=1337
POCKETBASE_PORT=8090
BIND_ADDR=0.0.0.0

VITE_OPS_API_BASE=/ops
VITE_OPS_API_MOCK=false

PB_EMAIL=admin@example.com
PB_PASSWORD=change-me

OPS_REGISTRATION_ENABLED=false
OPS_BOOTSTRAP_CORE_COLLECTIONS=false
OPS_BOOTSTRAP_ADMIN_ENABLED=false

PB_PUBLIC_URL=https://data.ikanyue.com
PUBLIC_ASSET_BASE_URL=https://kyoss.abcmem.com/ikanyue-mp
DEFAULT_AVATAR=

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_JSCODE2SESSION=https://api.weixin.qq.com/sns/jscode2session
