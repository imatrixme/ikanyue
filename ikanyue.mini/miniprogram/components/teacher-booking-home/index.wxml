<view class="page-chrome teacher-workbench">
    <view class="teacher-workbench__content">
        <upcoming-lessons id="upcoming" />
        <ticket-section wx:if="{{sections.teach}}" subtitle="开课后确认上课，按出勤扣除课时" title="待确认上课">
            <view wx:if="{{showTeacherFilter}}" class="workbench-filter">
                <text>按老师查看</text>
                <picker range="{{teacherOptions}}" range-key="label" value="{{teacherIndex}}" bindchange="changeTeacherFilter">
                    <view>{{teacherOptions[teacherIndex].label}}</view>
                </picker>
            </view>
            <view wx:if="{{visibleLessons.length}}" class="workbench-list">
                <view wx:for="{{visibleLessons}}" wx:for-item="lesson" wx:key="sessionId" class="workbench-lesson">
                    <view class="workbench-lesson__row">
                        <view class="workbench-lesson__body">
                            <text class="workbench-lesson__title">{{lesson.title}}</text>
                            <text class="workbench-lesson__meta">{{lesson.timeLabel}}{{lesson.location ? ' · ' + lesson.location : ''}}</text>
                            <text wx:if="{{lesson.teacherLabel}}" class="workbench-lesson__meta">老师：{{lesson.teacherLabel}}</text>
                            <text class="workbench-lesson__meta">学员：{{lesson.studentLabel}}</text>
                        </view>
                        <view class="workbench-actions">
                            <view class="workbench-button" aria-role="button" data-id="{{lesson.sessionId}}" bindtap="openConfirm">
                                {{lesson.reconfirm ? '重新确认' : '确认上课'}}
                            </view>
                            <view wx:if="{{sections.teachers}}" class="workbench-button workbench-button--quiet" aria-role="button" data-id="{{lesson.sessionId}}" bindtap="openSubstitute">
                                换老师
                            </view>
                        </view>
                    </view>
                </view>
            </view>
            <view wx:else class="workbench-empty">
                <app-icon name="booking-confirm" size="xl" />
                <text>没有待确认的课</text>
            </view>
        </ticket-section>
        <ticket-section wx:if="{{sections.students}}" subtitle="添加学员、发课时、查看和撤销核销" title="学员与课时">
            <view class="workbench-list">
                <account-row
                    description="{{sections.grant ? '选择学员后可以发课时' : '查看学员剩余课时'}}"
                    icon="account-teaching"
                    interactive="{{true}}"
                    title="学员"
                    value="管理"
                    bind:select="goStudents"
                />
            </view>
        </ticket-section>
        <ticket-section wx:if="{{sections.teachers}}" subtitle="老师请假时换人代课，老师离职时一次交接" title="老师">
            <view class="workbench-list">
                <account-row
                    description="代课与离职交接，学员课时不变"
                    icon="account-teaching"
                    interactive="{{true}}"
                    title="老师"
                    value="管理"
                    bind:select="goTeachers"
                />
            </view>
        </ticket-section>
        <view wx:if="{{state !== 'ready'}}" class="teacher-workbench__state">
            <async-state
                action-label="{{state === 'error' ? '重新加载' : ''}}"
                description="{{errorMessage || '开放课程预约后，学员申请会显示在这里。'}}"
                kind="{{state === 'error' ? 'network' : 'default'}}"
                state="{{state}}"
                title="{{state === 'error' ? '工作台加载失败' : '暂无预约任务'}}"
                bind:action="retry"
            />
        </view>
        <block wx:else>
            <ticket-section action-label="全部申请" subtitle="请在响应期限前完成确认或拒绝" title="待你确认" bind:action="goPending">
                <view wx:if="{{dashboard.pending.length}}" class="teacher-workbench__list">
                    <appointment-row
                        wx:for="{{dashboard.pending}}"
                        wx:for-item="appointment"
                        wx:key="appointmentId"
                        appointment="{{appointment}}"
                        perspective="teacher"
                        bind:select="goDetail"
                    />
                </view>
                <view wx:else class="teacher-workbench__empty">
                    <app-icon name="booking-confirm" size="xl" />
                    <text>当前没有待确认申请</text>
                </view>
            </ticket-section>

            <ticket-section subtitle="按机构开放时间设置每周与临时时段" title="可预约时间">
                <view class="teacher-workbench__offerings">
                    <account-row
                        wx:for="{{offerings}}"
                        wx:for-item="offering"
                        wx:key="offeringId"
                        item-id="{{offering.offeringId}}"
                        description="{{offering.description}}"
                        icon="booking-availability"
                        interactive="{{true}}"
                        title="{{offering.course.name}}"
                        value="设置"
                        bind:select="goAvailability"
                    />
                </view>
            </ticket-section>
        </block>
        <ticket-section wx:if="{{renewalRows.length}}" subtitle="教务会提醒学员查看课包，无需你沟通续费" title="待续费学员">
            <view class="teacher-workbench__list">
                <account-row
                    wx:for="{{renewalRows}}"
                    wx:for-item="row"
                    wx:key="key"
                    description="{{row.description}}"
                    icon-text="{{row.initial}}"
                    title="{{row.title}}"
                    value="{{row.value}}"
                />
            </view>
        </ticket-section>
    </view>
    <k-popup visible="{{showConfirm}}" panel-class="workbench-sheet-shell" bind:close="closeConfirm">
        <view class="workbench-sheet">
            <view class="workbench-sheet__bar" />
            <text class="workbench-sheet__title">确认上课</text>
            <text class="workbench-sheet__description">{{confirming.title}} · {{confirming.timeLabel}}</text>
            <text class="workbench-sheet__description">默认全部到课；点选没来的学员标记为缺席，确认后按出勤扣除课时。</text>
            <view
                wx:for="{{confirmRows}}"
                wx:for-item="student"
                wx:key="sessionStudentId"
                class="workbench-sheet__option {{student.absent ? 'selected' : ''}}"
                aria-role="button"
                data-id="{{student.sessionStudentId}}"
                bindtap="toggleAbsent"
            >
                <text>{{student.name}}</text>
                <text>{{student.absent ? '缺席' : '到课'}}</text>
            </view>
            <view class="workbench-submit {{actionLoading ? 'disabled' : ''}}" aria-role="button" bindtap="submitConfirm">
                {{actionLoading ? '正在提交' : '确认上课'}}
            </view>
        </view>
    </k-popup>
    <substitute-teacher lesson="{{substituting}}" visible="{{showSubstitute}}" bind:close="closeSubstitute" bind:done="substituted" />
</view>
