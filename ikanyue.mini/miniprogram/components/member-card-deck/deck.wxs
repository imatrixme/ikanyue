// Runs in the render layer so dragging never waits on setData.
// Each slot sits at a fractional position: 0 is the front card, 1 and 2 peek out behind it on the right,
// negative positions are flicked away to the left with a slight tilt.
var DRAG_SPAN = 240; // px of drag that moves the deck by one whole card
var COMMIT = 0.22; // share of DRAG_SPAN that commits a switch on release
var EASE = 'transform 420ms cubic-bezier(0.22, 0.9, 0.24, 1), opacity 320ms ease';

function slotStyle(pos) {
    if (pos < 0) {
        return {
            transform: 'translateX(' + pos * 118 + '%) rotate(' + pos * 9 + 'deg)',
            opacity: 1,
            'z-index': 30,
        };
    }
    return {
        transform: 'translateX(' + pos * 6 + '%) translateY(' + pos * 2 + '%) scale(' + (1 - pos * 0.07) + ')',
        opacity: pos > 2.5 ? 0 : 1 - pos * 0.18,
        'z-index': 20 - Math.round(pos * 5),
    };
}

function place(owner, state, shift, nudge, animate) {
    var slots = owner.selectAllComponents('.deck__slot');
    for (var i = 0; i < slots.length; i++) {
        var style = slotStyle(i - state.current + shift);
        style.transition = animate ? EASE : 'none';
        // With nowhere to go, the front card only follows the finger a little and springs back.
        if (nudge && i === state.current) style.transform = 'translateX(' + nudge + 'px)';
        slots[i].setStyle(style);
    }
}

// Re-lays the deck whenever the card count or the current card changes on the logic side.
function sync(value, oldValue, owner) {
    var parts = ((value || '0:0') + '').split(':');
    var state = owner.getState();
    state.count = parseInt(parts[0], 10) || 0;
    state.current = parseInt(parts[1], 10) || 0;
    place(owner, state, 0, 0, !!oldValue);
}

function start(event, owner) {
    var state = owner.getState();
    var touch = event.touches[0];
    state.x = touch.pageX;
    state.y = touch.pageY;
    state.axis = '';
    state.shift = 0;
}

function move(event, owner) {
    var state = owner.getState();
    var touch = event.touches[0];
    var dx = touch.pageX - state.x;
    var dy = touch.pageY - state.y;
    if (!state.axis) {
        if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
        state.axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
    }
    if (state.axis !== 'x') return;
    var progress = Math.min(Math.abs(dx) / DRAG_SPAN, 1);
    var canNext = dx < 0 && state.current < state.count - 1;
    var canPrevious = dx > 0 && state.current > 0;
    state.shift = canNext ? -progress : canPrevious ? progress : 0;
    place(owner, state, state.shift, state.shift ? 0 : dx * 0.25, false);
}

function end(event, owner) {
    var state = owner.getState();
    if (state.axis !== 'x') return;
    state.axis = '';
    var shift = state.shift;
    state.shift = 0;
    if (shift <= -COMMIT) state.current += 1;
    else if (shift >= COMMIT) state.current -= 1;
    place(owner, state, 0, 0, true);
    if (Math.abs(shift) >= COMMIT) owner.callMethod('onDeckChange', { current: state.current });
}

module.exports = { end: end, move: move, start: start, sync: sync };
