<view wx:if="{{imageUrl && !imageError}}" class="image-detail-page">
    <image src="{{imageUrl}}" class="detail-image" mode="widthFix" bind:error="handleImageError" />
</view>
<view wx:else class="image-detail-page image-detail-page--status">
    <empty-state
        action-label="返回活动"
        description="{{statusDescription}}"
        kind="image"
        title="{{statusText}}"
        bind:action="goBack"
    />
</view>
