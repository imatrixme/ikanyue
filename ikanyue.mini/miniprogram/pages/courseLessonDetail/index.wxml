<view class="page-chrome courses-page">
    <page-header subtitle="{{lesson.course.name}}" title="{{lesson.title}}" />
    <view class="courses-content">
        <view wx:if="{{state !== 'ready'}}" class="courses-state">
            <async-state action-label="{{state === 'error' ? '重新加载' : ''}}" description="{{errorMessage}}" kind="{{state === 'error' ? 'network' : 'default'}}" state="{{state}}" title="{{state === 'empty' ? '暂无课堂信息' : ''}}" bind:action="loadLesson" />
        </view>
        <block wx:else>
            <validity-notice wx:if="{{lesson.notice}}" description="{{lesson.notice}}" title="课程安排需要处理" tone="warning" />
            <ticket-section subtitle="以教学管理最终安排为准" title="课堂信息">
                <view class="courses-detail-facts">
                    <view class="courses-detail-fact"><text class="courses-detail-label">课程</text><text class="courses-detail-value">{{lesson.course.name}}</text></view>
                    <view class="courses-detail-fact"><text class="courses-detail-label">时间</text><text class="courses-detail-value">{{facts.time}}</text></view>
                    <view class="courses-detail-fact"><text class="courses-detail-label">地点</text><text class="courses-detail-value">{{lesson.location || '待通知'}}</text></view>
                    <view class="courses-detail-fact"><text class="courses-detail-label">课程状态</text><text class="courses-detail-value">{{facts.status}}</text></view>
                    <view class="courses-detail-fact"><text class="courses-detail-label">出勤结果</text><text class="courses-detail-value">{{facts.attendance}}</text></view>
                    <view class="courses-detail-fact"><text class="courses-detail-label">课时状态</text><text class="courses-detail-value">{{facts.lessonHour}}</text></view>
                </view>
            </ticket-section>
        </block>
    </view>
</view>
