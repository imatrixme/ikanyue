<view class="page-chrome appointments-page">

    <view class="appointments-content">
        <segmented-control value="{{statusFilter}}" options="{{filters}}" bind:change="selectFilter" />

        <view wx:if="{{state !== 'ready'}}" class="appointments-state">
            <async-state
                action-label="{{state === 'error' ? '重新加载' : ''}}"
                description="{{errorMessage || emptyDescription}}"
                kind="{{state === 'error' ? 'network' : 'default'}}"
                state="{{state}}"
                title="{{state === 'error' ? '预约记录加载失败' : '暂无预约记录'}}"
                bind:action="retry"
            />
        </view>
        <view wx:else class="appointments-list">
            <appointment-row
                wx:for="{{items}}" wx:for-item="appointment"
                wx:key="appointmentId"
                appointment="{{appointment}}"
                perspective="{{role}}"
                bind:select="goDetail"
            />
        </view>

        <view wx:if="{{loadingMore}}" class="appointments-footer">正在加载更多</view>
        <view wx:elif="{{items.length && !hasMore}}" class="appointments-footer">已显示全部预约</view>
    </view>
</view>
